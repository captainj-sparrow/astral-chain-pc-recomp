#version 450
// Frame generation's inputs drawn over the picture it shows (vk_dlssg.c, AC_DLSSG_MVDEBUG): the motion vectors and
// depth NGX was given for this frame, at the picture's size, read from render pixels.
// The vectors are drawn as a colour wheel: hue is the direction the surface moved on screen this frame, saturation how
// far (full at pc.scale render pixels), so a still surface keeps its own colour and one that moved is tinted. A legend
// of the wheel sits in the top-left corner, and a square under it tells the game's frame (green) from a generated one
// (magenta).
// Mode 1: the tint over the game's frame, its brightness kept so the scene can be read. Mode 2: the wheel alone.
// Mode 3: the depth, near white to far black on a log scale. Mode 4: where the picture differs from the HUD-less
// picture NGX was given, amplified: what NGX takes for the HUD and keeps still (black elsewhere). Mode 5: the alpha
// channel of the picture, mode 6 that of the HUD-less picture (black 0, white 1): whether the HUD's draws leave its
// coverage there, which frame generation's UI recomposition could use. Mode 7 (with AC_DLSSG_UI_ALPHA): the HUD as UI
// recomposition sees it: green where the alpha has HUD coverage, red where the picture differs from the HUD-less one
// but the alpha has none (HUD that NGX takes for scene and moves with it), the scene dimmed elsewhere. Mode 8: blue
// where the alpha claims HUD coverage (above a quarter) but the picture is the HUD-less one there: NGX's UI colour of
// such a pixel is the scene itself, which it lays back over the moving scene in the frames between.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D pic;     // the game's frame, at the picture's size
layout(binding = 1) uniform sampler2D mv_tex;  // RG16F render pixels: last frame's position minus this one's
layout(binding = 2) uniform sampler2D depth_tex;
layout(binding = 3) uniform writeonly image2D dst;   // the picture shown, at size
layout(binding = 4) uniform sampler2D hud_less;      // the HUD-less picture NGX was given, at size
layout(push_constant) uniform P {
    ivec2 size;     // the picture's size
    vec2 rsize;     // the render size of the vectors and the depth
    float scale;    // render pixels of motion for a fully saturated colour
    int mode;       // 1 tint, 2 vectors, 3 depth, 4 the HUD as NGX sees it, 5 / 6 the picture's / HUD-less alpha, 7 missed HUD, 8 HUD that is scene
    float near_z, far_z;
    int generated;  // 0 the game's frame, else the generated frame's index
} pc;

const float PI = 3.14159265;

vec3 hsv(float h, float s, float v) {
    vec3 k = clamp(abs(fract(h + vec3(0.0, 2.0, 1.0) / 3.0) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
    return v * mix(vec3(1.0), k, s);
}

// motion on screen this frame, render pixels (x right, y down)
vec3 wheel(vec2 m) {
    float h = atan(m.y, m.x) / (2.0 * PI) + 0.5;
    return hsv(h, clamp(length(m) / pc.scale, 0.0, 1.0), 1.0);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(pc.size);
    ivec2 rp = clamp(ivec2(uv * pc.rsize), ivec2(0), ivec2(pc.rsize) - 1);
    vec2 motion = -texelFetch(mv_tex, rp, 0).xy;
    vec3 c;
    if (pc.mode == 8) {
        vec4 b = texelFetch(pic, p, 0);
        vec3 d = abs(b.rgb - texelFetch(hud_less, p, 0).rgb);
        float diff = max(d.r, max(d.g, d.b));
        c = dot(b.rgb, vec3(0.2126, 0.7152, 0.0722)) * vec3(0.25);
        if (b.a > 0.25 && diff < 2.0 / 255.0) c = vec3(0.0, 0.4, 1.0);
        else if (b.a > 2.0 / 255.0) c = mix(c, vec3(0.0, 1.0, 0.0), 0.3);
    } else if (pc.mode == 7) {
        vec4 b = texelFetch(pic, p, 0);
        vec3 d = abs(b.rgb - texelFetch(hud_less, p, 0).rgb);
        float diff = max(d.r, max(d.g, d.b));
        c = dot(b.rgb, vec3(0.2126, 0.7152, 0.0722)) * vec3(0.25);
        if (b.a > 2.0 / 255.0) c = mix(c, vec3(0.0, 1.0, 0.0), 0.3 + 0.7 * b.a);
        else if (diff > 3.0 / 255.0) c = vec3(1.0, 0.0, 0.0);
    } else if (pc.mode == 5) {
        c = vec3(texelFetch(pic, p, 0).a);
    } else if (pc.mode == 6) {
        c = vec3(texelFetch(hud_less, p, 0).a);
    } else if (pc.mode == 4) {
        vec3 d = abs(texelFetch(pic, p, 0).rgb - texelFetch(hud_less, p, 0).rgb);
        c = vec3(clamp(max(d.r, max(d.g, d.b)) * 8.0, 0.0, 1.0));
    } else if (pc.mode == 3) {
        float d = texelFetch(depth_tex, rp, 0).r;
        float n = max(pc.near_z, 1e-4), f = max(pc.far_z, n * 2.0);
        float z = n * f / max(f - d * (f - n), 1e-6);   // view depth for 0 near .. 1 far
        c = vec3(1.0 - clamp(log2(z / n) / 14.0, 0.0, 1.0));
    } else if (pc.mode == 2) {
        c = wheel(motion);
    } else {
        vec3 s = texelFetch(pic, p, 0).rgb;
        float l = dot(s, vec3(0.2126, 0.7152, 0.0722));
        c = wheel(motion) * (0.2 + 0.8 * l);
    }
    // the legend: a vector from its centre to the pixel, the full radius at scale
    float r = max(32.0, float(pc.size.y) / 20.0);
    vec2 q = vec2(p) - vec2(r + 16.0);
    float dq = length(q);
    if (dq <= r) c = wheel(q / r * pc.scale);
    else if (dq <= r + 2.0) c = vec3(0.0);
    // the frame's kind, under the legend
    int k = int(r * 0.5), y0 = int(2.0 * r) + 32;
    if (p.x >= 16 && p.x < 16 + k && p.y >= y0 && p.y < y0 + k)
        c = pc.generated != 0 ? vec3(1.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
    imageStore(dst, p, vec4(c, 1.0));
}
