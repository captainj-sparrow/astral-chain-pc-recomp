msgctxt "UI_MENU_ADV_WARNING"
msgid "These settings are for testing and troubleshooting. Change them only when you know why."
msgstr "Queste impostazioni servono a collaudo e diagnostica. Cambiale solo se sai perché."

msgctxt "UI_MENU_GROUP_SCHED"
msgid "Scheduling"
msgstr "Pianificazione"

msgctxt "UI_MENU_GROUP_SHADERS"
msgid "Shaders and pipelines"
msgstr "Shader e pipeline"

