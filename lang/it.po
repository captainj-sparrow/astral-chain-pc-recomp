msgctxt "UI_MENU_FULLSCREEN"
msgid "Fullscreen"
msgstr "Schermo intero"

msgctxt "UI_MENU_FULLSCREEN_DESC"
msgid "Fills the screen with the game; F11 toggles it."
msgstr "Riempie lo schermo con il gioco; F11 lo attiva o disattiva."

msgctxt "UI_MENU_WINDOW_SIZE"
msgid "Window size"
msgstr "Dimensione finestra"

msgctxt "UI_MENU_WINDOW_SIZE_DESC"
msgid "Size of the game window when not fullscreen."
msgstr "Dimensione della finestra del gioco quando non è a schermo intero."

msgctxt "UI_MENU_WINDOW_SIZE_CUSTOM"
msgid "Custom"
msgstr "Personalizzata"

msgctxt "UI_MENU_PRESENT"
msgid "Presentation"
msgstr "Presentazione"

msgctxt "UI_MENU_PRESENT_DESC"
msgid "How finished frames reach the screen."
msgstr "Come i frame finiti raggiungono lo schermo."

msgctxt "UI_MENU_PRESENT_MAILBOX"
msgid "Mailbox"
msgstr "Mailbox"

msgctxt "UI_MENU_PRESENT_VSYNC"
msgid "VSync"
msgstr "VSync"

msgctxt "UI_MENU_PRESENT_IMMEDIATE"
msgid "Immediate"
msgstr "Immediata"

msgctxt "UI_MENU_PRESENT_IN_USE"
msgid "in use: %s"
msgstr "in uso: %s"

msgctxt "UI_MENU_LOW_LATENCY"
msgid "Low latency"
msgstr "Bassa latenza"

msgctxt "UI_MENU_LOW_LATENCY_DESC"
msgid "Starts each frame as late as it can still be shown on time, so the picture answers the controls sooner. Uses NVIDIA Reflex or AMD Anti-Lag 2 when the driver offers them, the port's own timing otherwise. Boost: with Reflex the GPU also keeps its clocks up; otherwise shorter waits, with a dropped frame now and then."
msgstr "Avvia ogni frame il più tardi possibile, purché venga comunque mostrato in tempo, così l'immagine risponde prima ai comandi. Usa NVIDIA Reflex o AMD Anti-Lag 2 se disponibili, altrimenti la sincronizzazione interna del port. In modalità Boost, con Reflex la GPU mantiene anche le frequenze alte; senza Reflex riduce i tempi di attesa, accettando di tanto in tanto un frame perso."

msgctxt "UI_MENU_LOW_LATENCY_OFF"
msgid "Off"
msgstr "No"

msgctxt "UI_MENU_LOW_LATENCY_ON"
msgid "On"
msgstr "Sì"

msgctxt "UI_MENU_LOW_LATENCY_BOOST"
msgid "Boost"
msgstr "Boost"

msgctxt "UI_MENU_LOW_LATENCY_BUILTIN"
msgid "built-in timing"
msgstr "sincronizzazione integrata"

msgctxt "UI_MENU_GPU"
msgid "Graphics card"
msgstr "Scheda video"

msgctxt "UI_MENU_GPU_DESC"
msgid "The Vulkan device that draws the game."
msgstr "Il dispositivo Vulkan che disegna il gioco."

msgctxt "UI_MENU_GPU_AUTO"
msgid "Automatic"
msgstr "Automatico"

msgctxt "UI_MENU_PERF_OVERLAY"
msgid "Performance overlay"
msgstr "Overlay prestazioni"

msgctxt "UI_MENU_PERF_OVERLAY_DESC"
msgid "Frame rate in the top right corner. Full adds frame times with a graph, CPU, GPU and memory load, temperatures and the render thread's waits. F10 cycles the modes."
msgstr "Frame rate in alto a destra. Completo aggiunge i tempi di frame con un grafico, carico CPU, GPU e memoria, temperature e attese del thread di rendering. F10 cambia modalità."

msgctxt "UI_MENU_PERF_OFF"
msgid "Off"
msgstr "No"

msgctxt "UI_MENU_PERF_FPS"
msgid "FPS"
msgstr "FPS"

msgctxt "UI_MENU_PERF_FULL"
msgid "Full"
msgstr "Completo"

msgctxt "UI_PERF_LINE_FPS"
msgid "%.0f fps"
msgstr "%.0f fps"

msgctxt "UI_MENU_GRAPHICS"
msgid "Picture"
msgstr "Immagine"

msgctxt "UI_MENU_OUTPUT_RES"
msgid "Game resolution"
msgstr "Risoluzione di gioco"

msgctxt "UI_MENU_OUTPUT_RES_DESC"
msgid "The size the game draws its picture and interface in. 1280 x 720 is the lightest, for weaker GPUs. Above 1920 x 1080 the game needs more memory (about 240 MB more at 2560 x 1440, 790 MB at 3840 x 2160) and GPU time. Takes effect after a restart. Automatic takes the screen's size: up to 1920 x 1080, and up to 3840 x 2160 while an upscaler runs."
msgstr "La dimensione in cui il gioco disegna immagine e interfaccia. 1280 x 720 è la più leggera, per GPU più deboli. Oltre 1920 x 1080 il gioco richiede più memoria (circa 240 MB in più a 2560 x 1440, 790 MB a 3840 x 2160) e più tempo GPU. Ha effetto dopo un riavvio. Automatica prende la dimensione dello schermo: fino a 1920 x 1080, e fino a 3840 x 2160 mentre un upscaler è attivo."

msgctxt "UI_MENU_UPSCALER"
msgid "Scaling to the window"
msgstr "Ridimensionamento alla finestra"

msgctxt "UI_MENU_UPSCALER_DESC"
msgid "How the picture is scaled to the window. FSR keeps edges and detail sharper than bilinear, and sharpens the picture even when it already fits the window."
msgstr "Come l'immagine viene scalata alla finestra. FSR rende bordi e dettagli più netti del bilineare, anche quando l'immagine è già alla stessa dimensione della finestra."

msgctxt "UI_MENU_UPSCALER_FSR"
msgid "AMD FSR 1"
msgstr "AMD FSR 1"

msgctxt "UI_MENU_UPSCALER_BILINEAR"
msgid "Bilinear"
msgstr "Bilineare"

msgctxt "UI_MENU_FOV"
msgid "Field of view"
msgstr "Campo visivo"

msgctxt "UI_MENU_FOV_DESC"
msgid "How much of the world the camera shows, in percent of the game's own (50 degrees vertically in play). Cutscenes keep the game's own framing."
msgstr "Quanto del mondo mostra la telecamera, in percentuale rispetto a quello del gioco (50 gradi verticali in gioco). Le cutscene mantengono l'inquadratura del gioco."

msgctxt "UI_MENU_DRAW_DISTANCE"
msgid "Draw distance"
msgstr "Distanza di disegno"

msgctxt "UI_MENU_DRAW_DISTANCE_DESC"
msgid "How far away objects keep their detailed model and small objects stay visible, in percent of the game's own. Higher shows less pop-in and draws more. Takes effect on what the game loads after the change, at the next loading screen."
msgstr "A quale distanza gli oggetti mantengono il modello dettagliato e i piccoli oggetti restano visibili, in percentuale rispetto a quello del gioco. Valori alti mostrano meno comparsa improvvisa e disegnano di più. Ha effetto su ciò che il gioco carica dopo la modifica, alla prossima schermata di caricamento."

msgctxt "UI_MENU_ANISO"
msgid "Texture filtering"
msgstr "Filtro texture"

msgctxt "UI_MENU_ANISO_DESC"
msgid "Anisotropic filtering of surface textures: ground, roads and walls seen at a shallow angle stay sharp into the distance instead of blurring. Game: the level the game asks for, as on the Switch. Auto: 16x with 3D render scale 1440p, twice the game's level at 2160p, the game's level otherwise."
msgstr "Filtro anisotropo delle texture di superficie: terreno, strade e muri visti di taglio restano nitidi in lontananza invece di sfocarsi. Gioco: il livello che il gioco richiede, come su Switch. Auto: 16x con scala 3D 1440p, due volte il livello del gioco a 2160p, altrimenti il livello del gioco."

msgctxt "UI_MENU_ANISO_GAME"
msgid "Game"
msgstr "Gioco"

msgctxt "UI_MENU_ANISO_AUTO"
msgid "Auto"
msgstr "Auto"

msgctxt "UI_MENU_SHARPNESS"
msgid "FSR sharpness"
msgstr "Nitidezza FSR"

msgctxt "UI_MENU_SHARPNESS_DESC"
msgid "Sharpening after FSR scaling; 0 turns it off."
msgstr "Nitidezza dopo la scala FSR; 0 la disattiva."

msgctxt "UI_MENU_COLOR"
msgid "Colour"
msgstr "Colore"

msgctxt "UI_MENU_COLOR_PRESET"
msgid "Colour profile"
msgstr "Profilo colore"

msgctxt "UI_MENU_COLOR_PRESET_DESC"
msgid "Sets the four values below. Vivid: more contrast and saturation, shadows opened a little (made for OLED screens). Clarity: a little more contrast, saturation and brightness. Moving a value makes the profile Custom. The HUD changes with the picture; this menu does not."
msgstr "Imposta i quattro valori qui sotto. Vivido: più contrasto e saturazione, ombre aperte un po' (creato per schermi OLED). Chiarezza: un po' più contrasto, saturazione e luminosità. Modificare un valore rende il profilo Personalizzato. La HUD cambia con l'immagine; questo menu no."

msgctxt "UI_MENU_COLOR_DEFAULT"
msgid "Game's own"
msgstr "Del gioco"

msgctxt "UI_MENU_COLOR_VIVID"
msgid "Vivid (OLED)"
msgstr "Vivido (OLED)"

msgctxt "UI_MENU_COLOR_CLARITY"
msgid "Clarity"
msgstr "Chiarezza"

msgctxt "UI_MENU_COLOR_CUSTOM"
msgid "Custom"
msgstr "Personalizzato"

msgctxt "UI_MENU_COLOR_BRIGHTNESS"
msgid "Brightness"
msgstr "Luminosità"

msgctxt "UI_MENU_COLOR_BRIGHTNESS_DESC"
msgid "Added to every colour; 0 leaves it."
msgstr "Aggiunta a ogni colore; 0 la lascia invariata."

msgctxt "UI_MENU_COLOR_CONTRAST"
msgid "Contrast"
msgstr "Contrasto"

msgctxt "UI_MENU_COLOR_CONTRAST_DESC"
msgid "Spreads colours away from mid-grey (above 100 %) or towards it; 100 % leaves them."
msgstr "Allontana i colori dal grigio medio (sopra 100 %) o li avvicina; 100 % li lascia invariati."

msgctxt "UI_MENU_COLOR_SATURATION"
msgid "Saturation"
msgstr "Saturazione"

msgctxt "UI_MENU_COLOR_SATURATION_DESC"
msgid "Colour strength against grey; 100 % leaves it."
msgstr "Intensità del colore rispetto al grigio; 100 % la lascia invariata."

msgctxt "UI_MENU_COLOR_GAMMA"
msgid "Gamma"
msgstr "Gamma"

msgctxt "UI_MENU_COLOR_GAMMA_DESC"
msgid "Below 1 brightens dark and middle tones, above 1 darkens them; 1 leaves them."
msgstr "Sotto 1 schiarisce le tonalità scure e medie, sopra 1 le scurisce; 1 le lascia invariate."

msgctxt "UI_MENU_HDR_GROUP"
msgid "HDR"
msgstr "HDR"

msgctxt "UI_MENU_HDR"
msgid "HDR output"
msgstr "Uscita HDR"

msgctxt "UI_MENU_HDR_DESC"
msgid "Bright highlights on an HDR display. Needs HDR turned on in Windows (\"Use HDR\") or in a Wayland compositor with colour management; without it the picture stays SDR. Applies after a restart. The colour profile above is for SDR and is not used in HDR."
msgstr "Luci vive su un display HDR. Richiede HDR attivo in Windows (\"Usa HDR\") o in un compositore Wayland con gestione del colore; senza resta SDR. Si applica dopo un riavvio. Il profilo colore qui sopra è per SDR e non viene usato in HDR."

msgctxt "UI_MENU_HDR_PEAK"
msgid "Peak brightness"
msgstr "Luminosità di picco"

msgctxt "UI_MENU_HDR_PEAK_DESC"
msgid "Your display's peak in nits; the brightest highlights stop there."
msgstr "Il picco del tuo display in nits; le luci più brillanti si fermano lì."

msgctxt "UI_MENU_HDR_GAME"
msgid "Game brightness"
msgstr "Luminosità di gioco"

msgctxt "UI_MENU_HDR_GAME_DESC"
msgid "Nits of the picture's white (paper white). 203 is the HDR reference; raise it in a bright room."
msgstr "Nits del bianco dell'immagine (bianco carta). 203 è il riferimento HDR; alzalo in una stanza luminosa."

msgctxt "UI_MENU_HDR_UI"
msgid "HUD and menu brightness"
msgstr "Luminosità HUD e menu"

msgctxt "UI_MENU_HDR_UI_DESC"
msgid "Nits of the HUD's and this menu's white."
msgstr "Nits del bianco della HUD e di questo menu."

msgctxt "UI_MENU_HDR_HUE"
msgid "Highlight hue correction"
msgstr "Correzione tinta luci"

msgctxt "UI_MENU_HDR_HUE_DESC"
msgid "Bright colours such as fire and sparks turn towards white as in the game's own SDR picture, matching the light they cast; 0 keeps them fully saturated."
msgstr "I colori vivaci come fuoco e scintille virano al bianco come nell'immagine SDR del gioco, in linea con la luce che emettono; 0 li tiene completamente saturi."

msgctxt "UI_MENU_SHADOW_SCALE"
msgid "Shadow resolution"
msgstr "Risoluzione ombre"

msgctxt "UI_MENU_SHADOW_SCALE_DESC"
msgid "Draws the sun's shadow map this many times larger on each side than the game's 2048x2048: sharper shadow edges and leaf shadows, for more video memory (about 85 to 130 MiB at 2x, 340 to 520 MiB at 4x). Takes effect at the next start."
msgstr "Aumenta la risoluzione della shadow map del sole rispetto al 2048x2048 originale del gioco. Migliora i bordi delle ombre e le ombre delle foglie, ma consuma più memoria video (circa 85-130 MiB a 2x, 340-520 MiB a 4x). Si applica al prossimo avvio."

msgctxt "UI_MENU_AO"
msgid "Ambient occlusion"
msgstr "Occlusione ambientale"

msgctxt "UI_MENU_AO_DESC"
msgid "Darkens creases, corners and the ground under characters and objects, where little of the surrounding light reaches. High + bounce light also adds the light the surfaces on screen send back to each other: a lit wall or floor brightens and tints what faces it, even from far away. Computed on the screen after the world is lit; the game has none of its own. Each level costs more GPU time than the one before; High + bounce light is demanding, so on a weak graphics card prefer High. Takes effect at once."
msgstr "Scurisce pieghe, angoli e il terreno sotto personaggi e oggetti, dove arriva poca luce ambientale. Alto + illuminazione indiretta aggiunge anche la luce indiretta che le superfici si rimandano a vicenda: un muro o un pavimento illuminato schiarisce e colora ciò che gli sta di fronte, anche da lontano. È calcolata a schermo dopo l'illuminazione del mondo (il gioco non ha un'occlusione ambientale propria). Ogni livello costa più tempo GPU del precedente; Alto + illuminazione indiretta è impegnativo, quindi su una scheda poco potente preferisci Alto. Ha effetto subito."

msgctxt "UI_MENU_AO_OFF"
msgid "Off"
msgstr "No"

msgctxt "UI_MENU_AO_LOW"
msgid "Low"
msgstr "Bassa"

msgctxt "UI_MENU_AO_HIGH"
msgid "High"
msgstr "Alta"

msgctxt "UI_MENU_AO_GI"
msgid "High + bounce light (demanding)"
msgstr "Alta + illuminazione indiretta (impegnativa)"

msgctxt "UI_MENU_UPSCALING"
msgid "Upscaler"
msgstr "Upscaler"

msgctxt "UI_MENU_UPSCALING_DESC"
msgid "A temporal upscaler in place of the game's anti-aliasing: smoother edges and less shimmer, and with a mode below Native more frames per second. NVIDIA DLSS needs an NVIDIA RTX GPU and nvngx_dlss.dll next to astralchain.exe, Intel XeSS a recent GPU and libxess.dll next to astralchain.exe; AMD FSR 3 runs on any GPU, AMD FSR 4 on a Radeon RX 6000 or newer. Automatic takes DLSS where it can run and FSR 3 elsewhere. DLSS, XeSS and FSR 4 chosen here take effect after a restart. The HUD is not touched."
msgstr "Un upscaler temporale al posto dell'anti-aliasing del gioco: bordi più levigati e meno sfarfallio, e con una modalità sotto Nativo più frame al secondo. NVIDIA DLSS richiede una GPU NVIDIA RTX e nvngx_dlss.dll accanto a astralchain.exe, Intel XeSS una GPU recente e libxess.dll accanto a astralchain.exe; AMD FSR 3 funziona su qualsiasi GPU, AMD FSR 4 su una Radeon RX 6000 o più recente. \"Automatico\" prende DLSS dove può girare e FSR 3 altrove. DLSS, XeSS e FSR 4 scelti qui hanno effetto dopo un riavvio. La HUD non viene toccata."

msgctxt "UI_MENU_UPSCALING_DESC_OTHER"
msgid "A temporal upscaler in place of the game's anti-aliasing: smoother edges and less shimmer, and with a mode below Native more frames per second. NVIDIA DLSS needs an NVIDIA RTX GPU and libnvidia-ngx-dlss.so next to astralchain, AMD FSR 3 runs on any GPU, AMD FSR 4 on a Radeon RX 6000 or newer; Automatic takes DLSS where it can run and FSR 3 elsewhere (Intel XeSS is Windows only). DLSS and FSR 4 chosen here take effect after a restart. The HUD is not touched."
msgstr "Un upscaler temporale al posto dell'anti-aliasing del gioco: bordi più levigati e meno sfarfallio, e con una modalità sotto Nativo più frame al secondo. NVIDIA DLSS richiede una GPU NVIDIA RTX e libnvidia-ngx-dlss.so accanto a astralchain, AMD FSR 3 funziona su qualsiasi GPU, AMD FSR 4 su una Radeon RX 6000 o più recente; \"Automatico\" prende DLSS dove può girare e FSR 3 altrove (Intel XeSS è solo per Windows). DLSS e FSR 4 scelti qui hanno effetto dopo un riavvio. La HUD non viene toccata."

msgctxt "UI_MENU_UPSCALING_OFF"
msgid "Off"
msgstr "No"

msgctxt "UI_MENU_UPSCALING_AUTO"
msgid "Automatic"
msgstr "Automatico"

msgctxt "UI_MENU_UPSCALING_UNAVAILABLE"
msgid "not available here"
msgstr "non disponibile qui"

msgctxt "UI_MENU_UPSCALING_INSTEAD"
msgid "not available here: %s in use"
msgstr "non disponibile qui: %s in uso"

msgctxt "UI_MENU_UPSCALING_MISSING"
msgid "%s is missing: %s in use"
msgstr "manca %s: %s in uso"

msgctxt "UI_MENU_UPSCALING_UNTIL"
msgid "%s until a restart"
msgstr "%s fino al riavvio"

msgctxt "UI_MENU_UPSCALING_QUALITY"
msgid "Upscaler mode"
msgstr "Modalità upscaler"

msgctxt "UI_MENU_UPSCALING_QUALITY_DESC"
msgid "The size the 3D scene is drawn at before the upscaler brings it to the game resolution (shown under the value). Native draws it at full size, the sharpest (DLAA under DLSS). Quality, Balanced, Performance and Ultra performance draw it at about 67, 58, 50 and 33 % for more frames per second; Ultra performance is meant for 3840 x 2160. Takes effect after a restart."
msgstr "La dimensione in cui la scena 3D viene disegnata prima che l'upscaler la porti alla risoluzione di gioco (mostrata sotto il valore). Nativo la disegna a dimensione piena, la più nitida (DLAA sotto DLSS). Qualità, Bilanciata, Prestazioni e Ultra prestazioni la disegnano a circa il 67, 58, 50 e 33 % per maggiori frame al secondo; Ultra prestazioni è pensata per 3840 x 2160. Ha effetto dopo un riavvio."

msgctxt "UI_MENU_UPSCALING_NATIVE"
msgid "Native"
msgstr "Nativo"

msgctxt "UI_MENU_DLSS_QUALITY"
msgid "Quality"
msgstr "Qualità"

msgctxt "UI_MENU_DLSS_BALANCED"
msgid "Balanced"
msgstr "Bilanciata"

msgctxt "UI_MENU_DLSS_PERFORMANCE"
msgid "Performance"
msgstr "Prestazioni"

msgctxt "UI_MENU_UPSCALING_ULTRA"
msgid "Ultra performance"
msgstr "Ultra prestazioni"

msgctxt "UI_MENU_UPSCALING_MODE_OFF"
msgid "no upscaler"
msgstr "nessun upscaler"

msgctxt "UI_MENU_AA"
msgid "Game anti-aliasing"
msgstr "Anti-aliasing"

msgctxt "UI_MENU_AA_DESC"
msgid "The game's own anti-aliasing, SMAA, for when no upscaler runs. Off leaves the edges jagged."
msgstr "L'anti-aliasing del gioco, SMAA, usato quando non c'è un upscaler attivo. Se disattivato, i bordi restano frastagliati."

msgctxt "UI_MENU_AA_OFF"
msgid "Off"
msgstr "No"

msgctxt "UI_MENU_AA_BY_UPSCALER"
msgid "the upscaler smooths the edges"
msgstr "demandato all'upscaler"

msgctxt "UI_MENU_OUTPUT_RES_AUTO"
msgid "Automatic"
msgstr "Automatica"

msgctxt "UI_MENU_OUTPUT_RES_NEXT"
msgid ", %s after restart"
msgstr ", %s dopo il riavvio"

msgctxt "UI_MENU_FPS_LIMIT"
msgid "Frame rate"
msgstr "Frame rate"

msgctxt "UI_MENU_FPS_LIMIT_DESC"
msgid "60 FPS runs the game's 60 fps patch; 30 FPS switches it off. Read live."
msgstr "60 FPS usa la patch 60 fps del gioco; 30 FPS la disattiva. Letto in tempo reale."

msgctxt "UI_MENU_FPS_30"
msgid "30 FPS"
msgstr "30 FPS"

msgctxt "UI_MENU_FPS_60"
msgid "60 FPS"
msgstr "60 FPS"

msgctxt "UI_MENU_REALTIME"
msgid "Game speed follows the clock"
msgstr "La velocità del gioco segue il clock"

msgctxt "UI_MENU_REALTIME_DESC"
msgid "Steps the game by real time, so a slow frame does not slow the game down."
msgstr "Fa avanzare il gioco in tempo reale, così un frame lento non rallenta il gioco."

msgctxt "UI_MENU_CLOTH_REALTIME"
msgid "Cloth on the clock"
msgstr "Tessuti in tempo reale"

msgctxt "UI_MENU_CLOTH_REALTIME_DESC"
msgid "Steps cloth and hair by real time as well."
msgstr "Tessuti e capelli anch'essi sincronizzati in tempo reale."

msgctxt "UI_MENU_HIGHFPS_FIX"
msgid "High frame rate fixes"
msgstr "Correzioni frame rate alto"

msgctxt "UI_MENU_HIGHFPS_FIX_DESC"
msgid "Corrects physics that misbehave above 30 frames per second, and objects that stay see-through or invisible above 60."
msgstr "Corregge la fisica che si comporta male oltre 30 frame al secondo, e gli oggetti che restano trasparenti o invisibili oltre 60."

msgctxt "UI_MENU_GAME_LANG"
msgid "Game language"
msgstr "Lingua di gioco"

msgctxt "UI_MENU_GAME_LANG_DESC"
msgid "Language of the game's text and voices."
msgstr "Lingua di testi e voci del gioco."

msgctxt "UI_MENU_GAME_LANG_AUTO"
msgid "Automatic"
msgstr "Automatica"

msgctxt "UI_MENU_OPERATION_MODE"
msgid "Console mode"
msgstr "Modalità console"

msgctxt "UI_MENU_OPERATION_MODE_DESC"
msgid "Whether the game thinks it runs docked or handheld."
msgstr "Se il gioco crede di girare in modalità TV o portatile."

msgctxt "UI_MENU_MODE_DOCKED"
msgid "Docked"
msgstr "Modalità TV"

msgctxt "UI_MENU_MODE_HANDHELD"
msgid "Handheld"
msgstr "Portatile"

msgctxt "UI_MENU_ASSUME_FOCUS"
msgid "Keep running out of focus"
msgstr "Rimani in esecuzione fuori focus"

msgctxt "UI_MENU_ASSUME_FOCUS_DESC"
msgid "On (the default), the game keeps running while you are in another window, and the keyboard stays quiet until the window is in front again. Off, the whole game, sound included, pauses while its window is out of focus, as on the Switch when Home is pressed."
msgstr "Sì (predefinito), il gioco rimane in esecuzione mentre sei in un'altra finestra, e la tastiera resta muta finché la finestra non torna davanti. No, l'intero gioco, audio incluso, va in pausa mentre la finestra non è attiva, come su Switch quando si preme Home."

msgctxt "UI_MENU_HUD"
msgid "HUD"
msgstr "HUD"

msgctxt "UI_MENU_HUD_DESC"
msgid "Off, the game's HUD is not drawn during play; the menus stay. F12 toggles it."
msgstr "No, la HUD del gioco non viene disegnata in gioco; i menu restano. F12 la attiva o disattiva."

msgctxt "UI_MENU_MODS_INSTALLED"
msgid "Installed mods"
msgstr "Mod installate"

msgctxt "UI_MENU_MODS_NONE"
msgid "No mods yet. Unpack a mod into the mods folder, one folder per mod with its romfs folder inside, and restart the game. TKMM can export its merged mods into a folder there too."
msgstr "Nessuna mod presente. Scompatta una mod nella cartella mods, una cartella per ogni mod con dentro la propria cartella romfs, e riavvia il gioco. TKMM può esportare le sue mod unite in una cartella lì."

msgctxt "UI_MENU_MODS_OPEN"
msgid "Open mods folder"
msgstr "Apri cartella mod"

msgctxt "UI_MENU_MODS_OPEN_DESC"
msgid "Shows the folder the game loads mods from. It is created if it is missing."
msgstr "Mostra la cartella da cui il gioco carica le mod. Viene creata se non esiste."

msgctxt "UI_MENU_DLC_GROUP"
msgid "Downloadable content"
msgstr "Contenuti scaricabili"

msgctxt "UI_MENU_DLC"
msgid "Load DLC"
msgstr "Carica DLC"

msgctxt "UI_MENU_DLC_DESC"
msgid "Loads the DLCs of the dlc folder next to astralchain.exe: trainings, texts and tutorial windows written by players as XML. They are built into the game's archives from your own game files at start and kept in your profile. Off: the game runs exactly as it is."
msgstr "Carica i DLC della cartella dlc accanto ad astralchain.exe: allenamenti, testi e finestre tutorial scritti dai giocatori in XML. Vengono integrati negli archivi del gioco dai tuoi file di gioco all'avvio e conservati nel tuo profilo. Disattivato: il gioco funziona esattamente come sempre."

msgctxt "UI_MENU_DLC_LOADED"
msgid "Loaded at this start: %s."
msgstr "Caricati all'avvio: %s."

msgctxt "UI_MENU_DLC_NONE"
msgid "No DLC was found in the dlc folder at this start."
msgstr "Nessun DLC trovato nella cartella dlc all'avvio."

msgctxt "UI_MENU_DLC_OPEN"
msgid "Open DLC folder"
msgstr "Apri cartella DLC"

msgctxt "UI_MENU_DLC_OPEN_DESC"
msgid "Shows the folder the game loads DLCs from, one folder per DLC with its dlc.xml. It is created if it is missing."
msgstr "Mostra la cartella da cui il gioco carica i DLC, una cartella per DLC con il suo dlc.xml. Viene creata se non esiste."

msgctxt "UI_MENU_MODS_ROW_DESC"
msgid "Game files it replaces: %u. New files it adds: %u."
msgstr "File di gioco che sostituisce: %u. File nuovi che aggiunge: %u."

msgctxt "UI_MENU_MODS_OVERRIDDEN"
msgid "%u of its files come from %s, which is higher in the list."
msgstr "%u dei suoi file provengono da %s, che è più in alto nella lista."

msgctxt "UI_MENU_MODS_MOVE_HINT"
msgid "The top face button or Ctrl+Up moves it up, the left face button or Ctrl+Down moves it down. When two mods change the same file, the higher one wins. Changes apply after a restart."
msgstr "Il pulsante superiore dei 4 frontali o Ctrl+Up lo sposta su, il pulsante sinistro dei 4 frontali o Ctrl+Down lo sposta giù. Quando due mod cambiano lo stesso file, quella in alto ha la priorità. Le modifiche hanno effetto dopo un riavvio."

msgctxt "UI_MENU_MODS_EMPTY"
msgid "This folder has no romfs, exefs or cheats files."
msgstr "Questa cartella non ha file romfs, exefs o trucchi."

msgctxt "UI_MENU_MODS_SUBSDK"
msgid "This mod brings its own game code (a subsdk plugin or a replaced main). The port cannot load code modules, so the whole mod stays off."
msgstr "Questa mod porta codice di gioco proprio (un plugin subsdk o un main sostituito). Il port non può caricare moduli di codice, quindi l'intera mod resta disattivata."

msgctxt "UI_MENU_MODS_EXEFS_LATER"
msgid "This mod patches the game code (exefs). The game builds the patches in when it starts next (a rebuild of a few minutes); until then the whole mod stays off."
msgstr "Questa mod applica patch al codice di gioco (exefs). Il gioco le costruisce al prossimo avvio (una ricostruzione di qualche minuto); fino ad allora l'intera mod resta disattivata."

msgctxt "UI_MENU_MODS_BAD_NAME"
msgid "The folder name contains |, which the mod list uses between names. Rename the folder."
msgstr "Il nome della cartella contiene |, che l'elenco mod usa tra i nomi. Rinomina la cartella."

msgctxt "UI_MENU_MODS_EXEFS_UNSUPPORTED"
msgid "This mod patches the game code (exefs) in a way the port cannot apply, so the whole mod stays off. %s"
msgstr "Questa mod applica patch al codice di gioco (exefs) in un modo che il port non può applicare, quindi l'intera mod resta disattivata. %s"

msgctxt "UI_MENU_MODS_EXEFS_OTHER"
msgid "Its code patches (exefs) are made for another game version."
msgstr "Le sue patch di codice (exefs) sono fatte per un'altra versione del gioco."

msgctxt "UI_MENU_MODS_EXEFS_ON"
msgid "Code patches in use: %d files."
msgstr "Patch di codice in uso: %d file."

msgctxt "UI_MENU_MODS_REPLACES_BUILTIN"
msgid "Code patches in use: %d files. They replace the port's own patch %s, which stays off while this mod is on."
msgstr "Patch di codice in uso: %d file. Sostituiscono la patch propria del port %s, che resta disattivata mentre questa mod è attiva."

msgctxt "UI_MENU_MODS_OTHER_VERSION"
msgid "%u of its files are made for another game version and are left out. Look for a version of this mod made for your game version."
msgstr "%u dei suoi file sono fatti per un'altra versione del gioco e vengono lasciati fuori. Cerca una versione di questa mod fatta per la tua versione del gioco."

msgctxt "UI_MENU_MODS_UNUSED"
msgid "not used"
msgstr "non usato"

msgctxt "UI_MENU_MODS_CHEATS"
msgid "Cheats: %d."
msgstr "Trucchi: %d."

msgctxt "UI_MENU_MODS_CHEATS_FILE"
msgid "Cheats for this game version are read at start from cheats\\%s in this mod."
msgstr "I trucchi per questa versione del gioco si leggono all'avvio da cheats\\%s in questa mod."

msgctxt "UI_MENU_VOLUME"
msgid "Volume"
msgstr "Volume"

msgctxt "UI_MENU_VOLUME_DESC"
msgid "Master volume of the game."
msgstr "Volume principale del gioco."

msgctxt "UI_MENU_AUDIO_OUTPUT"
msgid "Audio output"
msgstr "Uscita audio"

msgctxt "UI_MENU_AUDIO_OUTPUT_DESC"
msgid "What the game mixes. In 5.1 the centre (the voices) and the surrounds get channels of their own; it needs a 5.1 or 7.1 output. Elsewhere the 5.1 mix is folded down to stereo. Automatic picks 5.1 when the output takes it at start, stereo otherwise."
msgstr "Cosa mixa il gioco. In 5.1 il centro (le voci) e i canali surround hanno canali propri; serve un'uscita 5.1 o 7.1. Altrimenti il mix 5.1 viene convertito in stereo. Automatico sceglie il 5.1 all'avvio se l'uscita lo supporta, altrimenti lo stereo."

msgctxt "UI_MENU_AUDIO_OUTPUT_DESC_WIN"
msgid "What the game mixes. In 5.1 the centre (the voices) and the surrounds get channels of their own; it needs a 5.1 or 7.1 output, or a headset with spatial sound on: Windows Sonic for Headphones, Dolby Atmos for Headphones or DTS Headphone:X, in the device's properties in the Windows sound settings. Elsewhere the 5.1 mix is folded down to stereo. Automatic picks 5.1 when the output takes it at start, stereo otherwise."
msgstr "Cosa mixa il gioco. In 5.1 il centro (le voci) e i canali surround hanno canali propri; serve un'uscita 5.1 o 7.1, o una cuffia con suono spaziale attivo: Windows Sonic for Headphones, Dolby Atmos for Headphones o DTS Headphone:X, nelle proprietà del dispositivo nelle impostazioni audio di Windows. Altrimenti il mix 5.1 viene convertito in stereo. Automatico sceglie il 5.1 all'avvio se l'uscita lo supporta, altrimenti lo stereo."

msgctxt "UI_MENU_AUDIO_AUTO"
msgid "Automatic"
msgstr "Automatico"

msgctxt "UI_MENU_AUDIO_STEREO"
msgid "Stereo"
msgstr "Stereo"

msgctxt "UI_MENU_AUDIO_51"
msgid "5.1"
msgstr "5.1"

msgctxt "UI_MENU_AUDIO_TAKES_51_SPATIAL"
msgid "%s: Windows spatial sound is on and turns 5.1 into surround on headphones."
msgstr "%s: il suono spaziale di Windows è attivo e trasforma il 5.1 in surround sulle cuffie."

msgctxt "UI_MENU_AUDIO_TAKES_51"
msgid "%s: %d channels, 5.1 goes out as it is."
msgstr "%s: %d canali, il 5.1 esce così com'è."

msgctxt "UI_MENU_AUDIO_FOLDS_51"
msgid "%s: %d channels, no 5.1: a 5.1 mix is folded down to stereo."
msgstr "%s: %d canali, niente 5.1: un mix 5.1 viene convertito in stereo."

msgctxt "UI_MENU_AUDIO_SONIC_HINT"
msgid "With headphones, turn on Windows Sonic for Headphones (or Dolby Atmos, DTS Headphone:X) in the device's properties."
msgstr "Con le cuffie, attiva Windows Sonic for Headphones (o Dolby Atmos, DTS Headphone:X) nelle proprietà del dispositivo."

msgctxt "UI_MENU_AUDIO_SENDING"
msgid "The game sends %d channels."
msgstr "Il gioco invia %d canali."

msgctxt "UI_MENU_AUDIO_NO_DEVICE"
msgid "No audio output found."
msgstr "Nessuna uscita audio trovata."

msgctxt "UI_MENU_AUDIO_MIX_HINT"
msgid "Choose 5.1 above and restart the game to set each speaker."
msgstr "Scegli 5.1 qui sopra e riavvia il gioco per impostare ogni altoparlante."

msgctxt "UI_MENU_AUDIO_GROUP_OUTPUT"
msgid "Speakers and headphones"
msgstr "Altoparlanti e cuffie"

msgctxt "UI_MENU_AUDIO_GROUP_MIX"
msgid "Speaker mix"
msgstr "Mix altoparlanti"

msgctxt "UI_MENU_AUDIO_RESTART_DESC"
msgid "Closes the game and starts it again with the new audio output. Progress since your last save is lost."
msgstr "Chiude il gioco e lo riavvia con la nuova uscita audio. I progressi dall'ultimo salvataggio vengono persi."

msgctxt "UI_MENU_AUDIO_TEST"
msgid "Test speakers"
msgstr "Prova altoparlanti"

msgctxt "UI_MENU_AUDIO_TEST_DESC"
msgid "Plays a noise on each speaker in turn, as an A/V receiver does: check that every speaker works and sits where the diagram shows it. The game's sound is muted meanwhile. Press again to stop."
msgstr "Riproduce un rumore su ogni altoparlante a turno, come fa un ricevitore A/V: verifica che ogni altoparlante funzioni e sia dove indica lo schema. Il suono del gioco resta muto. Premi di nuovo per fermare."

msgctxt "UI_MENU_AUDIO_TEST_START"
msgid "Start"
msgstr "Avvia"

msgctxt "UI_MENU_AUDIO_TEST_STOP"
msgid "press to stop"
msgstr "premi per fermare"

msgctxt "UI_MENU_AUDIO_PRESET"
msgid "Mix"
msgstr "Mix"

msgctxt "UI_MENU_AUDIO_PRESET_DESC"
msgid "Ready-made mixes. Balanced: the recommended mix. Clear voices: the dialogue in front, softer surrounds. Immersive: stronger surrounds, and the bass to the subwoofer. Moving any speaker below makes it Custom."
msgstr "Mix già pronti. Bilanciato: il mix consigliato. Voci chiare: i dialoghi in primo piano, surround più soft. Immersivo: surround più forti, e i bassi al subwoofer. Muovere qualsiasi altoparlante qui sotto lo rende Personalizzato."

msgctxt "UI_MENU_AUDIO_PRESET_BALANCED"
msgid "Balanced"
msgstr "Bilanciato"

msgctxt "UI_MENU_AUDIO_PRESET_VOICES"
msgid "Clear voices"
msgstr "Voci chiare"

msgctxt "UI_MENU_AUDIO_PRESET_IMMERSIVE"
msgid "Immersive"
msgstr "Immersivo"

msgctxt "UI_MENU_AUDIO_PRESET_CUSTOM"
msgid "Custom"
msgstr "Personalizzato"

msgctxt "UI_MENU_AUDIO_FRONT_LEFT"
msgid "Front left"
msgstr "Anteriore sinistro"

msgctxt "UI_MENU_AUDIO_FRONT_RIGHT"
msgid "Front right"
msgstr "Anteriore destro"

msgctxt "UI_MENU_AUDIO_CENTER"
msgid "Centre (voices)"
msgstr "Centro (voci)"

msgctxt "UI_MENU_AUDIO_SURROUND_LEFT"
msgid "Surround left"
msgstr "Surround sinistro"

msgctxt "UI_MENU_AUDIO_SURROUND_RIGHT"
msgid "Surround right"
msgstr "Surround destro"

msgctxt "UI_MENU_AUDIO_SUBWOOFER"
msgid "Subwoofer"
msgstr "Subwoofer"

msgctxt "UI_MENU_AUDIO_FRONT_DESC"
msgid "Level of this front speaker. The fronts carry mostly the music, which the game mixes in stereo, and the sounds in front of you; lowering them lowers the music most. For the music alone, use the game's own music volume."
msgstr "Livello di questo altoparlante anteriore. Gli anteriori portano soprattutto la musica, che il gioco mescola in stereo, e i suoni davanti a te; abbassarli abbassa soprattutto la musica. Per la sola musica, usa il volume musica del gioco."

msgctxt "UI_MENU_AUDIO_CENTER_DESC"
msgid "Level of the centre speaker, where the voices and the interface sounds are. Lower it if voices or beeps are too loud; -2 dB keeps them near their level in stereo."
msgstr "Livello dell'altoparlante centrale, dove ci sono le voci e i suoni dell'interfaccia. Abbassalo se le voci o i bip sono troppo alti; -2 dB li tiene vicini al loro livello in stereo."

msgctxt "UI_MENU_AUDIO_SURROUND_DESC"
msgid "Level of this surround speaker. The surrounds carry the ambience, the reverb and the sounds beside and behind you."
msgstr "Livello di questo altoparlante surround. I surround portano l'ambiente, il riverbero e i suoni accanto e dietro di te."

msgctxt "UI_MENU_AUDIO_SUBWOOFER_DESC"
msgid "Level of the subwoofer. The game sends it nothing of its own: turn on Bass to subwoofer to give it the low end of the other speakers."
msgstr "Livello del subwoofer. Il gioco non gli invia nulla di proprio: attiva Bassi al subwoofer per dargli le frequenze basse degli altri altoparlanti."

msgctxt "UI_MENU_AUDIO_BASS"
msgid "Bass to subwoofer"
msgstr "Bassi al subwoofer"

msgctxt "UI_MENU_AUDIO_BASS_DESC"
msgid "Sends the bass (below 120 Hz) of the other five speakers to the subwoofer. Leave it off with headphones, or when your receiver already manages the bass."
msgstr "Invia i bassi (sotto 120 Hz) degli altri cinque altoparlanti al subwoofer. Lascialo spento con le cuffie, o quando il receiver gestisce già i bassi."

msgctxt "UI_MENU_SPK_LEFT"
msgid "Left"
msgstr "Sinistro"

msgctxt "UI_MENU_SPK_RIGHT"
msgid "Right"
msgstr "Destro"

msgctxt "UI_MENU_SPK_CENTER"
msgid "Centre"
msgstr "Centro"

msgctxt "UI_MENU_SPK_SURROUND_LEFT"
msgid "Surround L"
msgstr "Surround S"

msgctxt "UI_MENU_SPK_SURROUND_RIGHT"
msgid "Surround R"
msgstr "Surround D"

msgctxt "UI_MENU_SPK_SUB"
msgid "Sub"
msgstr "Sub"

msgctxt "UI_MENU_SPK_YOU"
msgid "You"
msgstr "Tu"

msgctxt "UI_MENU_MOTION"
msgid "Motion controls"
msgstr "Giroscopio"

msgctxt "UI_MENU_MOTION_DESC"
msgid "Aiming with the controller's gyroscope."
msgstr "Mira con il giroscopio del controller."

msgctxt "UI_MENU_RUMBLE_STRENGTH"
msgid "Vibration strength"
msgstr "Intensità vibrazione"

msgctxt "UI_MENU_RUMBLE_STRENGTH_DESC"
msgid "How strong the controller vibrates."
msgstr "Quanto vibra il controller."

msgctxt "UI_MENU_RUMBLE_CURVE"
msgid "Vibration curve"
msgstr "Curva di vibrazione"

msgctxt "UI_MENU_RUMBLE_CURVE_DESC"
msgid "Lower values make weak vibration stronger."
msgstr "Valori più bassi rendono più forte la vibrazione debole."

msgctxt "UI_MENU_RUMBLE_TRIGGERS"
msgid "Trigger vibration (Xbox)"
msgstr "Vibrazione grilletti (Xbox)"

msgctxt "UI_MENU_RUMBLE_TRIGGERS_DESC"
msgid "Vibrates the triggers of an Xbox controller too."
msgstr "Fa vibrare anche i grilletti di un controller Xbox."

msgctxt "UI_MENU_PAD_LAYOUT"
msgid "Button layout"
msgstr "Disposizione pulsanti"

msgctxt "UI_MENU_PAD_LAYOUT_DESC"
msgid "Which button is A. Nintendo: the right one, as on a Switch. Xbox: the bottom one, as labelled on an Xbox controller. PlayStation: the bottom one as labelled (cross) and the rest by position, to match the PlayStation button mod. Automatic picks Nintendo for controllers with Nintendo labels, PlayStation for PlayStation controllers and Xbox for the others. Which controller the game's prompts show is set under Button prompts."
msgstr "Quale pulsante è A. Nintendo: quello a destra, come su Switch. Xbox: quello in basso, come etichettato su un controller Xbox. PlayStation: quello in basso come etichettato (croce) e gli altri per posizione, per corrispondere alla mod pulsanti PlayStation. Automatico sceglie Nintendo per controller con etichette Nintendo, PlayStation per controller PlayStation e Xbox per gli altri. Quale controller mostrano le icone del gioco si imposta sotto Icone pulsanti."

msgctxt "UI_MENU_PAD_LAYOUT_AUTO"
msgid "Automatic"
msgstr "Automatico"

msgctxt "UI_MENU_PAD_LAYOUT_NINTENDO"
msgid "Nintendo (A right)"
msgstr "Nintendo (A a destra)"

msgctxt "UI_MENU_PAD_LAYOUT_XBOX"
msgid "Xbox (A bottom)"
msgstr "Xbox (A in basso)"

msgctxt "UI_MENU_PAD_LAYOUT_PLAYSTATION"
msgid "PlayStation (A bottom)"
msgstr "PlayStation (A in basso)"

msgctxt "UI_MENU_PAD_LAYOUT_IN_USE"
msgid "in use: %s"
msgstr "in uso: %s"

msgctxt "UI_MENU_PROMPTS"
msgid "Button prompts"
msgstr "Icone pulsanti"

msgctxt "UI_MENU_PROMPTS_DESC"
msgid "Which controller's buttons the game's prompts show. Automatic follows the controller in use (the Xbox or PlayStation mod when built, else Nintendo). Nintendo: the game's own. Xbox and PlayStation: button mods drawn for one layout each (a loaded mod forces its layout: Xbox for the Xbox mod, PlayStation for the PlayStation mod). The game reads its prompts at start, so they change after a restart."
msgstr "I pulsanti di quale controller mostrano le icone del gioco. Automatico segue il controller in uso (la mod Xbox o PlayStation se presente, altrimenti Nintendo). Nintendo: quelle del gioco. Xbox e PlayStation: mod pulsanti disegnate per una disposizione ciascuna (una mod caricata impone la sua disposizione: Xbox per la mod Xbox, PlayStation per la mod PlayStation). Il gioco legge le sue icone all'avvio, quindi cambiano dopo un riavvio."

msgctxt "UI_MENU_PROMPTS_AUTO"
msgid "Automatic"
msgstr "Automatico"

msgctxt "UI_MENU_PROMPTS_NINTENDO"
msgid "Nintendo"
msgstr "Nintendo"

msgctxt "UI_MENU_PROMPTS_XBOX"
msgid "Xbox"
msgstr "Xbox"

msgctxt "UI_MENU_PROMPTS_PLAYSTATION"
msgid "PlayStation"
msgstr "PlayStation"

msgctxt "UI_MENU_PROMPTS_MISSING"
msgid "prompt files missing: run the setup again"
msgstr "file icone mancanti: riesegui l'installazione"

msgctxt "UI_MENU_PROMPTS_FAILED"
msgid "prompt files damaged: run the setup again"
msgstr "file icone danneggiati: riesegui l'installazione"

msgctxt "UI_MENU_PROMPTS_RESTART"
msgid "prompts change after restart"
msgstr "le icone cambiano dopo il riavvio"

msgctxt "UI_MENU_PROMPTS_OFF_SHAPE"
msgid "off at a game resolution not 16:9"
msgstr "disattivate con risoluzione di gioco diversa da 16:9"

msgctxt "UI_MENU_PROMPTS_OFF_MODS"
msgid "off: a RomFS mod replaces their files"
msgstr "disattivate: una mod RomFS sostituisce i loro file"

msgctxt "UI_MENU_PROMPTS_OFF_PATCHES"
msgid "off while AC_ROMFS_PATCHES is set"
msgstr "disattivate mentre AC_ROMFS_PATCHES è impostato"

msgctxt "UI_MENU_RESTART"
msgid "Restart now"
msgstr "Riavvia ora"

msgctxt "UI_MENU_RESTART_DESC"
msgid "Closes the game and starts it again with the new prompts. Progress since your last save is lost."
msgstr "Chiude il gioco e lo riavvia con le nuove icone. I progressi dall'ultimo salvataggio vengono persi."

msgctxt "UI_MENU_RESTART_CONFIRM"
msgid "Restart the game now? Progress since your last save is lost."
msgstr "Riavviare il gioco ora? I progressi dall'ultimo salvataggio vengono persi."

msgctxt "UI_MENU_RESTART_YES"
msgid "Restart"
msgstr "Riavvia"

msgctxt "UI_MENU_RESTART_SAVING"
msgid "The game is saving: Restart is possible in a moment."
msgstr "Il gioco sta salvando: Riavvia sarà possibile tra un momento."

msgctxt "UI_MENU_LSTICK_DEADZONE"
msgid "Left stick dead zone"
msgstr "Zona morta stick sinistro"

msgctxt "UI_MENU_RSTICK_DEADZONE"
msgid "Right stick dead zone"
msgstr "Zona morta stick destro"

msgctxt "UI_MENU_STICK_DEADZONE_DESC"
msgid "How far a gamepad stick moves before the game sees it. Raise it if the character or the camera moves on its own: let go of the stick, read \"stick now\" and set the dead zone a few percent above it."
msgstr "Quanto si muove uno stick del gamepad prima che il gioco lo veda. Alzala se il personaggio o la telecamera si muovono da soli: rilascia lo stick, leggi \"stick ora\" e imposta la zona morta qualche punto percentuale in più."

msgctxt "UI_MENU_STICK_DEADZONE_NOW"
msgid "stick now: %.0f %%"
msgstr "stick ora: %.0f %%"

msgctxt "UI_MENU_TRIGGER_THRESHOLD"
msgid "Trigger threshold"
msgstr "Soglia dei grilletti"

msgctxt "UI_MENU_TRIGGER_THRESHOLD_DESC"
msgid "How far a gamepad trigger (ZL, ZR) is pulled before the game sees it pressed. 0 reacts to the slightest pull. Raise it if a trigger presses on its own: let go of it, read \"triggers now\" and set the threshold a few percent above it."
msgstr "Quanto deve essere premuto un grilletto del controller (ZL, ZR) prima che il gioco lo consideri premuto. 0 reagisce al minimo tocco. Aumenta se un grilletto si attiva da solo: rilascialo, leggi \"grilletti ora\" e imposta la soglia qualche percento più alta."

msgctxt "UI_MENU_TRIGGER_THRESHOLD_NOW"
msgid "triggers now: L %.0f %%, R %.0f %%"
msgstr "grilletti ora: L %.0f %%, R %.0f %%"

msgctxt "UI_MENU_STICK_SENS"
msgid "Stick camera speed"
msgstr "Velocità telecamera stick"

msgctxt "UI_MENU_STICK_SENS_DESC"
msgid "Multiplies the game's own right-stick camera speed, top speed included, at each of the game's five camera sensitivities. The mouse keeps its own setting."
msgstr "Moltiplica la velocità di telecamera dello stick destro del gioco, velocità massima inclusa, a ciascuna delle cinque sensibilità di telecamera del gioco. Il mouse mantiene la sua impostazione."

msgctxt "UI_MENU_MOUSE_SENS"
msgid "Mouse camera sensitivity"
msgstr "Sensibilità mouse telecamera"

msgctxt "UI_MENU_MOUSE_SENS_DESC"
msgid "How fast the mouse turns the camera."
msgstr "Quanto velocemente il mouse gira la telecamera."

msgctxt "UI_MENU_WALK_KEY"
msgid "Walk key"
msgstr "Tasto camminata"

msgctxt "UI_MENU_WALK_KEY_DESC"
msgid "Hold it to tilt the keyboard's sticks part of the way, so the keyboard walks instead of runs. The walk scale sets how far. A controller and the mouse are not affected."
msgstr "Tienilo premuto per inclinare solo a metà gli stick della tastiera, così la tastiera cammina invece di correre. La scala di camminata imposta quanto. Controller e mouse non sono influenzati."

msgctxt "UI_MENU_WALK_KEY_TAKEN"
msgid "also %s"
msgstr "anche %s"

msgctxt "UI_MENU_WALK_SCALE"
msgid "Walk scale"
msgstr "Scala di camminata"

msgctxt "UI_MENU_WALK_SCALE_DESC"
msgid "The tilt the keyboard's sticks get while the walk key is held. Half is a walk, the full tilt a run."
msgstr "L'inclinazione che gli stick della tastiera ricevono mentre il tasto camminata è premuto. Metà è una camminata, l'inclinazione piena una corsa."

msgctxt "UI_BINDS_HELP"
msgid "Select a cell and press A or Enter, then the key, mouse button or controller button. Delete or X clears a cell. A key in use moves here; a controller button swaps with the one it replaces."
