msgctxt "UI_MENU_ASYNC_PREEMPT"
msgid "Virtual core preemption"
msgstr "虚拟核心抢占"

msgctxt "UI_MENU_ASYNC_PREEMPT_DESC"
msgid "Lets a game thread interrupt another one on the same virtual core."
msgstr "允许同一虚拟核心上的一个游戏线程打断另一个。"

msgctxt "UI_MENU_PREEMPT_OFF"
msgid "Off"
msgstr "关"

msgctxt "UI_MENU_PREEMPT_ON"
msgid "On"
msgstr "开"

msgctxt "UI_MENU_PREEMPT_INHERIT"
msgid "Inheritance only"
msgstr "仅继承"

msgctxt "UI_MENU_REPLAY_ASYNC"
msgid "GPU frame prep on its own thread"
msgstr "GPU 帧准备独立线程"

msgctxt "UI_MENU_REPLAY_ASYNC_DESC"
msgid "Prepares frames for the GPU on a separate thread instead of the game thread. Adds up to one frame of latency."
msgstr "在单独的线程而不是游戏线程上为 GPU 准备帧。最多增加一帧延迟。"

msgctxt "UI_MENU_TIMER_1MS"
msgid "1 ms Windows timer"
msgstr "1 ms Windows 计时器"

msgctxt "UI_MENU_TIMER_1MS_DESC"
msgid "Raises the system timer resolution to 1 ms for steadier frame pacing."
msgstr "将系统计时器精度提高到 1 ms，使帧间隔更平稳。"

msgctxt "UI_MENU_PIPE_WAIT"
msgid "Waiting draw handling"
msgstr "等待中绘制的处理"

msgctxt "UI_MENU_PIPE_WAIT_DESC"
msgid "Default keeps the current scheduling with a reserved worker for waiting draws; Old (draw) uses the previous scheduling."
msgstr "默认保留当前调度，并为等待中的绘制预留一个工作线程；旧版（绘制）沿用先前的调度。"

msgctxt "UI_MENU_PIPE_WAIT_DEFAULT"
msgid "Default"
msgstr "默认"

msgctxt "UI_MENU_PIPE_WAIT_DRAW"
msgid "Old (draw)"
msgstr "旧版（绘制）"

msgctxt "UI_MENU_PIPE_SKIP"
msgid "Draws skipped while a pipeline builds"
msgstr "构建管线时跳过的绘制"

msgctxt "UI_MENU_PIPE_SKIP_DESC"
msgid "Which draws are dropped instead of waiting for their pipeline."
msgstr "哪些绘制会被直接丢弃，而不是等待其管线构建完成。"

msgctxt "UI_MENU_PIPE_SKIP_STRICT"
msgid "Strict"
msgstr "严格"

msgctxt "UI_MENU_PIPE_SKIP_ANY"
msgid "Any"
msgstr "任意"

msgctxt "UI_MENU_PIPE_SKIP_FULLSCREEN"
msgid "Fullscreen passes"
msgstr "全屏通道"

msgctxt "UI_MENU_LIB_PREBUILD"
msgid "Stage library prebuild"
msgstr "阶段库预构建"

msgctxt "UI_MENU_LIB_PREBUILD_DESC"
msgid "Builds shader stage libraries ahead of time in the background."
msgstr "在后台提前构建着色器阶段库。"

msgctxt "UI_MENU_LIB_PREBUILD_THREADS"
msgid "Stage library prebuild threads"
msgstr "阶段库预构建线程数"

msgctxt "UI_MENU_LIB_PREBUILD_THREADS_DESC"
msgid "Threads used for the prebuild; Automatic picks a number from your CPU."
msgstr "预构建使用的线程数；自动会根据你的 CPU 选择。"

msgctxt "UI_MENU_PIPE_PREBUILD"
msgid "Pipeline prebuild"
msgstr "管线预构建"

msgctxt "UI_MENU_PIPE_PREBUILD_DESC"
msgid "Builds known pipelines ahead of time."
msgstr "提前构建已知的管线。"

msgctxt "UI_MENU_PREWARM_XLATE"
msgid "Translator prewarm"
msgstr "着色器转译预热"

msgctxt "UI_MENU_PREWARM_XLATE_DESC"
msgid "Threads that translate known shaders at start; Automatic takes half the CPU threads, at most 16."
msgstr "启动时转译已知着色器的线程数；自动取 CPU 线程数的一半，最多 16。"

msgctxt "UI_MENU_GPL"
msgid "Graphics pipeline library"
msgstr "图形管线库"

msgctxt "UI_MENU_GPL_DESC"
msgid "Uses the Vulkan pipeline library extension; turn off if your driver misbehaves with it."
msgstr "使用 Vulkan 管线库扩展；驱动对此有问题时请关闭。"

msgctxt "UI_MENU_ASTC"
msgid "ASTC texture decoding"
msgstr "ASTC 纹理解码"

msgctxt "UI_MENU_ASTC_DESC"
msgid "Where compressed ASTC textures are decoded."
msgstr "压缩的 ASTC 纹理在哪里解码。"

msgctxt "UI_MENU_ASTC_AUTO"
msgid "Automatic"
msgstr "自动"

msgctxt "UI_MENU_ASTC_GPU"
msgid "GPU shader"
msgstr "GPU 着色器"

msgctxt "UI_MENU_ASTC_NATIVE"
msgid "Native"
msgstr "原生"

msgctxt "UI_MENU_ASTC_CPU"
msgid "CPU"
msgstr "CPU"

msgctxt "UI_MENU_MEMORY"
msgid "GPU memory mode"
msgstr "GPU 内存模式"

msgctxt "UI_MENU_MEMORY_DESC"
msgid "How game memory is shared with the GPU."
msgstr "游戏内存如何与 GPU 共享。"

msgctxt "UI_MENU_MEMORY_AUTO"
msgid "Automatic"
msgstr "自动"

msgctxt "UI_MENU_MEMORY_IMPORT"
msgid "Import"
msgstr "导入"

msgctxt "UI_MENU_MEMORY_MIRROR"
msgid "Mirror"
msgstr "镜像"

msgctxt "UI_MENU_MEMORY_VERIFY"
msgid "Verify"
msgstr "校验"

msgctxt "UI_MENU_TEX_ALIAS"
msgid "Texture aliasing"
msgstr "纹理别名"

msgctxt "UI_MENU_TEX_ALIAS_DESC"
msgid "A new texture created over a live texture's memory starts with that content instead of empty."
msgstr "在仍在使用的纹理内存上新建纹理时，新纹理沿用原有内容，而不是从空白开始。"

msgctxt "UI_MENU_TEX_VRAM_PRESSURE"
msgid "Texture memory limit"
msgstr "纹理显存上限"

msgctxt "UI_MENU_TEX_VRAM_PRESSURE_DESC"
msgid "Percent of video memory above which textures the game released are dropped (they come back from storage when used again). 0 keeps them."
msgstr "显存占用超过这个百分比后，游戏已释放的纹理会被丢弃，再次用到时从存储重新加载。0 表示不丢弃。"

msgctxt "UI_MENU_ASTC_BC"
msgid "Compress ASTC to BC"
msgstr "ASTC 压缩为 BC"

msgctxt "UI_MENU_ASTC_BC_DESC"
msgid "With the GPU decoder: re-encodes decoded ASTC textures to BC1 when the alpha scan proves them opaque, BC3 otherwise — a quarter to an eighth of the video memory. For GPUs with 4 GB or less; textures look slightly blockier."
msgstr "配合 GPU 解码器使用：不透明的 ASTC 纹理重新编码为 BC1，其余编码为 BC3，显存占用为原来的八分之一到四分之一。适用于 4 GB 及以下的显卡；纹理会出现轻微色块。"

msgctxt "UI_MENU_LOD_GUARD"
msgid "LOD guard"
msgstr "LOD 保护"

msgctxt "UI_MENU_LOD_GUARD_DESC"
msgid "Prevents objects flashing in the wrong place or a flat far field for a frame, by waiting for the game to finish rewriting level-of-detail data before the GPU reads it."
msgstr "等待游戏改写完细节层次数据后再让 GPU 读取，避免物体错位闪现，或远景有一帧变平。"

msgctxt "UI_MENU_FIX_C0"
msgid "Constant buffer fix"
msgstr "常量缓冲区修正"

msgctxt "UI_MENU_FIX_C0_DESC"
msgid "Fills the driver-reserved constant bank c0 (storage sizes, dispatch size, point size, base instance) instead of reading zeros."
msgstr "填充驱动保留的常量组 c0（存储缓冲区大小、派发大小、点大小、基础实例），而不是读取零值。"

msgctxt "UI_MENU_FIX_ZERO"
msgid "Zero new GPU memory"
msgstr "清零新的 GPU 内存"

msgctxt "UI_MENU_FIX_ZERO_DESC"
msgid "New GPU memory pools start zero-filled, as Switch memory does."
msgstr "新的 GPU 内存池初始内容为零，与 Switch 内存一致。"

msgctxt "UI_MENU_BIND_SKIP"
msgid "Skip repeated binds"
msgstr "跳过重复绑定"

msgctxt "UI_MENU_BIND_SKIP_DESC"
msgid "Optimisation: skips bindings that did not change."
msgstr "优化：跳过没有变化的绑定。"

msgctxt "UI_MENU_SHADER_MEMO"
msgid "Shader memo"
msgstr "着色器查找缓存"

msgctxt "UI_MENU_SHADER_MEMO_DESC"
msgid "Optimisation: remembers shader lookups."
msgstr "优化：记住着色器的查找结果。"

msgctxt "UI_MENU_PIPE_MEMO"
msgid "Pipeline memo"
msgstr "管线缓存"

msgctxt "UI_MENU_PIPE_MEMO_DESC"
msgid "Optimisation: reuses the previous draw's pipeline when its state repeats."
msgstr "优化：状态重复时复用上一次绘制的管线。"

msgctxt "UI_MENU_TEX_MEMO"
msgid "Texture binding memo"
msgstr "纹理绑定缓存"

msgctxt "UI_MENU_TEX_MEMO_DESC"
msgid "Optimisation: remembers texture descriptors between draws."
msgstr "优化：在多次绘制之间记住纹理描述符。"

msgctxt "UI_MENU_DESC_TEMPLATE"
msgid "Descriptor templates"
msgstr "描述符模板"

msgctxt "UI_MENU_DESC_TEMPLATE_DESC"
msgid "Optimisation: updates descriptors in bulk."
msgstr "优化：批量更新描述符。"

msgctxt "UI_MENU_PUSH_SKIP"
msgid "Skip repeated push constants"
msgstr "跳过重复推送常量"

msgctxt "UI_MENU_PUSH_SKIP_DESC"
msgid "Optimisation: skips push constants that did not change."
msgstr "优化：跳过没有变化的推送常量。"

msgctxt "UI_MENU_SPLIT_DRAWS"
msgid "Early GPU submission"
msgstr "提前提交 GPU 工作"

msgctxt "UI_MENU_SPLIT_DRAWS_DESC"
msgid "Submits GPU work in parts every N draws between passes so the GPU starts earlier; 0 turns it off."
msgstr "在渲染通道之间每隔 N 次绘制分批提交 GPU 工作，让 GPU 更早开始；0 为关闭。"

msgctxt "UI_MENU_VK_VALIDATION"
msgid "Validation layer"
msgstr "验证层"

msgctxt "UI_MENU_VK_VALIDATION_DESC"
msgid "Checks every Vulkan call and slows the game down a lot."
msgstr "检查每一次 Vulkan 调用，会大幅拖慢游戏。"

msgctxt "UI_MENU_VK_VALIDATION_MISSING"
msgid "The validation layer is not installed."
msgstr "未安装验证层。"

msgctxt "UI_MENU_VK_DYN_VERTEX"
msgid "Dynamic vertex state"
msgstr "动态顶点状态"

msgctxt "UI_MENU_VK_DYN_VERTEX_DESC"
msgid "Forces dynamic vertex input on or off; the default depends on the GPU."
msgstr "强制开关动态顶点输入；默认值取决于显卡。"

msgctxt "UI_MENU_VK_DYN_A2C"
msgid "Dynamic alpha to coverage"
msgstr "动态 Alpha 覆盖"

msgctxt "UI_MENU_VK_DYN_A2C_DESC"
msgid "Forces dynamic alpha to coverage on or off. Default: off on AMD's driver for RDNA 2 and older, which draws characters black with it, on elsewhere."
msgstr "强制开关动态 Alpha 覆盖。默认：AMD RDNA 2 及更早的驱动上为关闭，开启会导致人物变黑；其他显卡上为开启。"

msgctxt "UI_MENU_VK_SUBGROUP_PIN"
msgid "Pin subgroup size"
msgstr "固定子群大小"

msgctxt "UI_MENU_VK_SUBGROUP_PIN_DESC"
msgid "Fixes the shader subgroup size."
msgstr "固定着色器的子群大小。"

msgctxt "UI_MENU_TRACE"
msgid "Performance log"
msgstr "性能日志"

msgctxt "UI_MENU_TRACE_DESC"
msgid "Writes frame timings to a file."
msgstr "把每帧耗时写入文件。"

msgctxt "UI_MENU_FLIGHT"
msgid "Flight recorder"
msgstr "飞行记录仪"

msgctxt "UI_MENU_FLIGHT_DESC"
msgid "Keeps a short history and saves it when a frame freezes."
msgstr "保留一小段历史记录，在画面卡住时保存。"

msgctxt "UI_MENU_FLIGHT_SPIKE_MS"
msgid "Freeze threshold (ms)"
msgstr "卡顿阈值（ms）"

msgctxt "UI_MENU_FLIGHT_SPIKE_MS_DESC"
msgid "Frame time that counts as a freeze."
msgstr "算作卡顿的帧时间。"

msgctxt "UI_MENU_INPUT_RECORD"
msgid "Input recording"
msgstr "输入录制"

msgctxt "UI_MENU_INPUT_RECORD_DESC"
msgid "Writes your inputs to a file for bug reports."
msgstr "把你的输入写入文件，用于反馈问题。"

msgctxt "UI_MENU_OPEN_LOG"
msgid "Open log folder"
msgstr "打开日志文件夹"

msgctxt "UI_MENU_OPEN_LOG_DESC"
msgid "Shows the folder with the log files."
msgstr "显示存放日志文件的文件夹。"

msgctxt "UI_MENU_COPY_INFO"
msgid "Copy system info"
msgstr "复制系统信息"

msgctxt "UI_MENU_COPY_INFO_DESC"
msgid "Copies GPU, driver, CPU, RAM and changed settings to the clipboard."
msgstr "把显卡、驱动、CPU、内存和改动过的设置复制到剪贴板。"

msgctxt "UI_MENU_COPY_INFO_DONE"
msgid "Copied"
msgstr "已复制"

