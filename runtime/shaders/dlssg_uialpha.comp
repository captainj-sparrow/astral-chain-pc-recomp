#version 450
// Frame generation's UI alpha (vk_dlssg.c, AC_DLSSG_UI_ALPHA): the alpha channel of the picture the game presents,
// which holds the HUD's coverage there (vk_exec_draw.c), into the single-channel image NGX takes as DLSSG.UIAlpha.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;           // the picture (the window texture's copy)
layout(binding = 1) uniform writeonly image2D dst;   // R8, of its size
layout(push_constant) uniform P {
    ivec2 size;
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;
    imageStore(dst, p, vec4(texelFetch(src, p, 0).a));
}
