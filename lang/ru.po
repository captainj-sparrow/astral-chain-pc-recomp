msgid "UI_MENU_GPL"
msgstr "Библиотека графических конвейеров"

#. English: "Uses the Vulkan pipeline library extension; turn off if your driver misbehaves with it."
msgid "UI_MENU_GPL_DESC"
msgstr "Использует расширение Vulkan для библиотек конвейеров; выключите, если драйвер с ним сбоит."

#. English: "ASTC texture decoding"
msgid "UI_MENU_ASTC"
msgstr "Распаковка текстур ASTC"

#. English: "Where compressed ASTC textures are decoded."
msgid "UI_MENU_ASTC_DESC"
msgstr "Где распаковываются сжатые текстуры ASTC."

#. English: "Automatic"
msgid "UI_MENU_ASTC_AUTO"
msgstr "Автоматически"

#. English: "GPU shader"
msgid "UI_MENU_ASTC_GPU"
msgstr "Шейдер GPU"

#. English: "Native"
msgid "UI_MENU_ASTC_NATIVE"
msgstr "Аппаратно"

#. English: "CPU"
msgid "UI_MENU_ASTC_CPU"
msgstr "Процессор"

#. English: "GPU memory mode"
msgid "UI_MENU_MEMORY"
msgstr "Режим памяти GPU"

#. English: "How game memory is shared with the GPU."
msgid "UI_MENU_MEMORY_DESC"
msgstr "Как память игры передаётся видеокарте."

#. English: "Automatic"
msgid "UI_MENU_MEMORY_AUTO"
msgstr "Автоматически"

#. English: "Import"
msgid "UI_MENU_MEMORY_IMPORT"
msgstr "Импорт"

#. English: "Mirror"
msgid "UI_MENU_MEMORY_MIRROR"
msgstr "Зеркало"

#. English: "Verify"
msgid "UI_MENU_MEMORY_VERIFY"
msgstr "Проверка"

#. English: "Texture aliasing"
msgid "UI_MENU_TEX_ALIAS"
msgstr "Наследование содержимого текстур"

#. English: "A new texture created over a live texture's memory starts with that content instead of empty."
msgid "UI_MENU_TEX_ALIAS_DESC"
msgstr "Новая текстура поверх памяти живой текстуры получает её содержимое, а не пустую."

#. English: "Texture memory limit"
msgid "UI_MENU_TEX_VRAM_PRESSURE"
msgstr "Предел памяти текстур"

#. English: "Percent of video memory above which textures the game released are dropped (they come back from storage when used again). 0 keeps them."
msgid "UI_MENU_TEX_VRAM_PRESSURE_DESC"
msgstr "Процент видеопамяти, выше которого освобождённые игрой текстуры удаляются (при повторном использовании загружаются снова). 0 — не удалять."

#. English: "Compress ASTC to BC"
msgid "UI_MENU_ASTC_BC"
msgstr "Сжатие ASTC в BC"

#. English: "With the GPU decoder: re-encodes decoded ASTC textures to BC1 when the alpha scan proves them opaque, BC3 otherwise — a quarter to an eighth of the video memory. For GPUs with 4 GB or less; textures look slightly blockier."
msgid "UI_MENU_ASTC_BC_DESC"
msgstr "С декодером на GPU: текстуры без прозрачности пересжимаются в BC1, остальные в BC3 — от восьмой до четверти видеопамяти. Для видеокарт с 4 ГБ и меньше; текстуры чуть более блочные."

#. English: "LOD guard"
msgid "UI_MENU_LOD_GUARD"
msgstr "Защита LOD"

#. English: "Prevents objects flashing in the wrong place or a flat far field for a frame, by waiting for the game to finish rewriting level-of-detail data before the GPU reads it."
msgid "UI_MENU_LOD_GUARD_DESC"
msgstr "Не даёт объектам мелькать не на своём месте, а дальнему плану — на кадр становиться плоским: ждёт, пока игра допишет данные уровней детализации, и только потом их читает GPU."

#. English: "Constant buffer fix"
msgid "UI_MENU_FIX_C0"
msgstr "Исправление константного буфера"

#. English: "Fills the driver-reserved constant bank c0 (storage sizes, dispatch size, point size, base instance) instead of reading zeros."
msgid "UI_MENU_FIX_C0_DESC"
msgstr "Заполняет зарезервированный драйвером банк констант c0 (размеры хранилищ, размер запуска, размер точки, базовый экземпляр) вместо чтения нулей."

#. English: "Zero new GPU memory"
msgid "UI_MENU_FIX_ZERO"
msgstr "Обнулять новую память GPU"

#. English: "New GPU memory pools start zero-filled, as Switch memory does."
msgid "UI_MENU_FIX_ZERO_DESC"
msgstr "Новые пулы памяти GPU заполняются нулями, как память Switch."

#. English: "Skip repeated binds"
msgid "UI_MENU_BIND_SKIP"
msgstr "Пропуск повторных привязок"

#. English: "Optimisation: skips bindings that did not change."
msgid "UI_MENU_BIND_SKIP_DESC"
msgstr "Оптимизация: пропускает неизменившиеся привязки."

#. English: "Shader memo"
msgid "UI_MENU_SHADER_MEMO"
msgstr "Память шейдеров"

#. English: "Optimisation: remembers shader lookups."
msgid "UI_MENU_SHADER_MEMO_DESC"
msgstr "Оптимизация: запоминает поиск шейдеров."

#. English: "Pipeline memo"
msgid "UI_MENU_PIPE_MEMO"
msgstr "Память конвейера"

#. English: "Optimisation: reuses the previous draw's pipeline when its state repeats."
msgid "UI_MENU_PIPE_MEMO_DESC"
msgstr "Оптимизация: повторяет конвейер прошлой отрисовки, если её состояние не изменилось."

#. English: "Texture binding memo"
msgid "UI_MENU_TEX_MEMO"
msgstr "Память привязок текстур"

#. English: "Optimisation: remembers texture descriptors between draws."
msgid "UI_MENU_TEX_MEMO_DESC"
msgstr "Оптимизация: запоминает дескрипторы текстур между отрисовками."

#. English: "Descriptor templates"
msgid "UI_MENU_DESC_TEMPLATE"
msgstr "Шаблоны дескрипторов"

#. English: "Optimisation: updates descriptors in bulk."
msgid "UI_MENU_DESC_TEMPLATE_DESC"
msgstr "Оптимизация: обновляет дескрипторы пачками."

#. English: "Skip repeated push constants"
msgid "UI_MENU_PUSH_SKIP"
msgstr "Пропуск повторных push-констант"

#. English: "Optimisation: skips push constants that did not change."
msgid "UI_MENU_PUSH_SKIP_DESC"
msgstr "Оптимизация: пропускает неизменившиеся push-константы."

#. English: "Early GPU submission"
msgid "UI_MENU_SPLIT_DRAWS"
msgstr "Ранняя отправка работы GPU"

#. English: "Submits GPU work in parts every N draws between passes so the GPU starts earlier; 0 turns it off."
msgid "UI_MENU_SPLIT_DRAWS_DESC"
msgstr "Отправляет работу GPU частями через каждые N отрисовок между проходами, чтобы GPU начинал раньше; 0 — выключено."

#. English: "Validation layer"
msgid "UI_MENU_VK_VALIDATION"
msgstr "Слой проверки"

#. English: "Checks every Vulkan call and slows the game down a lot."
msgid "UI_MENU_VK_VALIDATION_DESC"
msgstr "Проверяет каждый вызов Vulkan и сильно замедляет игру."

#. English: "The validation layer is not installed."
msgid "UI_MENU_VK_VALIDATION_MISSING"
msgstr "Слой проверки не установлен."

#. English: "Dynamic vertex state"
msgid "UI_MENU_VK_DYN_VERTEX"
msgstr "Динамическое состояние вершин"

#. English: "Forces dynamic vertex input on or off; the default depends on the GPU."
msgid "UI_MENU_VK_DYN_VERTEX_DESC"
msgstr "Принудительно включает или выключает динамический ввод вершин; по умолчанию зависит от GPU."

#. English: "Dynamic alpha to coverage"
msgid "UI_MENU_VK_DYN_A2C"
msgstr "Динамический alpha to coverage"

#. English: "Forces dynamic alpha to coverage on or off. Default: off on AMD's driver for RDNA 2 and older, which draws characters black with it, on elsewhere."
msgid "UI_MENU_VK_DYN_A2C_DESC"
msgstr "Принудительно включает или выключает динамический alpha to coverage. По умолчанию выключен на драйвере AMD для RDNA 2 и старше, где с ним персонажи чёрные, и включён на остальных."

#. English: "Pin subgroup size"
msgid "UI_MENU_VK_SUBGROUP_PIN"
msgstr "Фиксировать размер подгруппы"

#. English: "Fixes the shader subgroup size."
msgid "UI_MENU_VK_SUBGROUP_PIN_DESC"
msgstr "Фиксирует размер подгруппы шейдера."

#. English: "Performance log"
msgid "UI_MENU_TRACE"
msgstr "Журнал производительности"

#. English: "Writes frame timings to a file."
msgid "UI_MENU_TRACE_DESC"
msgstr "Пишет время кадров в файл."

#. English: "Flight recorder"
msgid "UI_MENU_FLIGHT"
msgstr "Запись последних кадров (для отчёта о фризе)"

#. English: "Keeps a short history and saves it when a frame freezes."
msgid "UI_MENU_FLIGHT_DESC"
msgstr "Хранит короткую историю и сохраняет её, когда кадр подвисает."

#. English: "Freeze threshold (ms)"
msgid "UI_MENU_FLIGHT_SPIKE_MS"
msgstr "Порог подвисания (мс)"

#. English: "Frame time that counts as a freeze."
msgid "UI_MENU_FLIGHT_SPIKE_MS_DESC"
msgstr "Время кадра, которое считается подвисанием."

#. English: "Input recording"
msgid "UI_MENU_INPUT_RECORD"
msgstr "Запись ввода"

#. English: "Writes your inputs to a file for bug reports."
msgid "UI_MENU_INPUT_RECORD_DESC"
msgstr "Пишет ваш ввод в файл для отчёта об ошибке."

#. English: "Open log folder"
msgid "UI_MENU_OPEN_LOG"
msgstr "Открыть папку журналов"

#. English: "Shows the folder with the log files."
msgid "UI_MENU_OPEN_LOG_DESC"
msgstr "Показывает папку с файлами журнала."

#. English: "Copy system info"
msgid "UI_MENU_COPY_INFO"
msgstr "Копировать сведения о системе"

#. English: "Copies GPU, driver, CPU, RAM and changed settings to the clipboard."
msgid "UI_MENU_COPY_INFO_DESC"
msgstr "Копирует в буфер обмена видеокарту, драйвер, процессор, память и изменённые настройки."

#. English: "Copied"
msgid "UI_MENU_COPY_INFO_DONE"
msgstr "Скопировано"

#. English: "did not work"
msgid "UI_MENU_ACTION_FAILED"
msgstr "не получилось"

#. English: "Reset all settings to defaults"
msgid "UI_MENU_RESET"
msgstr "Сбросить все настройки"

#. English: "Applies to every tab."
msgid "UI_MENU_RESET_DESC"
msgstr "Действует на все вкладки."

#. English: "Reset every setting to its default?"
msgid "UI_MENU_RESET_CONFIRM"
msgstr "Сбросить все настройки к значениям по умолчанию?"

