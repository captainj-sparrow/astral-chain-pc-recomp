#version 450
// Camera motion vectors for DLAA (vk_dlaa.c mv_pass): each pixel's depth, as this frame's clip space, goes through one
// matrix to last frame's clip space; the vector is last frame's window position minus this frame's, in render pixels,
// without the jitter (DLSS's default convention). Objects that move on their own get only the camera's motion.
// The matrix is last frame's view-projection times the inverse of this frame's, made on the CPU in double precision
// from Astral Chain's scene camera (c3, view-projection in vec4 rows 8-11): a float inverse per pixel gave a fraction
// of a pixel of noise on distant surfaces, which DLSS follows into a shimmer. A still camera gives the identity and
// exactly zero motion. The game's projection maps depth to 0..w. The replay's viewports have negative heights, so
// window y grows downwards from ndc y = +1. The depth buffer holds z_ndc, or z_ndc * 0.5 + 0.5 when the game set
// NVN's NEAR_IS_MINUS_W depth mode (pc.mode.x).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D depth_tex;
layout(binding = 1, rg16f) uniform writeonly image2D mv_out;
layout(binding = 2, std140) uniform Rep { vec4 r[4]; } rep;   // rows of the reprojection, row-major
layout(push_constant) uniform P {
    vec2 size;     // render size in pixels
    vec2 jitter;   // this frame's jitter, pixels, as the scene was drawn (window x right, y down)
    vec4 mode;     // x: 1 for -w..w clip depth (NEAR_IS_MINUS_W), 0 for 0..w
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.size.x) || p.y >= int(pc.size.y)) return;
    float d = texelFetch(depth_tex, p, 0).r;
    vec2 win = vec2(p) + 0.5 - pc.jitter;   // where this pixel's surface sits without the jitter
    float zn = pc.mode.x > 0.5 ? d * 2.0 - 1.0 : d;
    vec4 ndc = vec4(win.x / pc.size.x * 2.0 - 1.0, 1.0 - win.y / pc.size.y * 2.0, zn, 1.0);
    vec4 clip = transpose(mat4(rep.r[0], rep.r[1], rep.r[2], rep.r[3])) * ndc;
    vec2 mv = vec2(0.0);
    if (clip.w > 1e-6) {
        vec2 pn = clip.xy / clip.w;
        vec2 pwin = vec2((pn.x * 0.5 + 0.5) * pc.size.x, (0.5 - pn.y * 0.5) * pc.size.y);
        mv = pwin - win;
    }
    imageStore(mv_out, p, vec4(mv, 0.0, 0.0));
}
