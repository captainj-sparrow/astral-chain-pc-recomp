msgid "UI_PERF_LINE_FPS"
msgstr ""

#. English: "Picture"
msgid "UI_MENU_GRAPHICS"
msgstr ""

#. English: "Game resolution"
msgid "UI_MENU_OUTPUT_RES"
msgstr ""

#. English: "The size the game draws its picture and interface in. 1280 x 720 is the lightest, for weaker GPUs. Above 1920 x 1080 the game needs more memory (about 240 MB more at 2560 x 1440, 790 MB at 3840 x 2160) and GPU time. Takes effect after a restart. Automatic takes the screen's size: up to 1920 x 1080, and up to 3840 x 2160 while an upscaler runs."
msgid "UI_MENU_OUTPUT_RES_DESC"
msgstr ""

#. English: "Scaling to the window"
msgid "UI_MENU_UPSCALER"
msgstr ""

#. English: "How the picture is scaled to the window. FSR keeps edges and detail sharper than bilinear, and sharpens the picture even when it already fits the window."
msgid "UI_MENU_UPSCALER_DESC"
msgstr ""

#. English: "AMD FSR 1"
msgid "UI_MENU_UPSCALER_FSR"
msgstr ""

#. English: "Bilinear"
msgid "UI_MENU_UPSCALER_BILINEAR"
msgstr ""

#. English: "Field of view"
msgid "UI_MENU_FOV"
msgstr ""

#. English: "How much of the world the camera shows, in percent of the game's own (50 degrees vertically in play). Cutscenes keep the game's own framing."
msgid "UI_MENU_FOV_DESC"
msgstr ""

#. English: "Draw distance"
msgid "UI_MENU_DRAW_DISTANCE"
msgstr ""

#. English: "How far away objects keep their detailed model and small objects stay visible, in percent of the game's own. Higher shows less pop-in and draws more. Takes effect on what the game loads after the change, at the next loading screen."
msgid "UI_MENU_DRAW_DISTANCE_DESC"
msgstr ""

#. English: "Texture filtering"
msgid "UI_MENU_ANISO"
msgstr ""

#. English: "Anisotropic filtering of surface textures: ground, roads and walls seen at a shallow angle stay sharp into the distance instead of blurring. Game: the level the game asks for, as on the Switch. Auto: 16x with 3D render scale 1440p, twice the game's level at 2160p, the game's level otherwise."
msgid "UI_MENU_ANISO_DESC"
msgstr ""

#. English: "Game"
msgid "UI_MENU_ANISO_GAME"
msgstr ""

#. English: "Auto"
msgid "UI_MENU_ANISO_AUTO"
msgstr ""

#. English: "FSR sharpness"
msgid "UI_MENU_SHARPNESS"
msgstr ""

#. English: "Sharpening after FSR scaling; 0 turns it off."
msgid "UI_MENU_SHARPNESS_DESC"
msgstr ""

#. English: "Colour"
msgid "UI_MENU_COLOR"
msgstr ""

#. English: "Colour profile"
msgid "UI_MENU_COLOR_PRESET"
msgstr ""

#. English: "Sets the four values below. Vivid: more contrast and saturation, shadows opened a little (made for OLED screens). Clarity: a little more contrast, saturation and brightness. Moving a value makes the profile Custom. The HUD changes with the picture; this menu does not."
msgid "UI_MENU_COLOR_PRESET_DESC"
msgstr ""

#. English: "Game's own"
msgid "UI_MENU_COLOR_DEFAULT"
msgstr ""

#. English: "Vivid (OLED)"
msgid "UI_MENU_COLOR_VIVID"
msgstr ""

#. English: "Clarity"
msgid "UI_MENU_COLOR_CLARITY"
msgstr ""

#. English: "Custom"
msgid "UI_MENU_COLOR_CUSTOM"
msgstr ""

#. English: "Brightness"
msgid "UI_MENU_COLOR_BRIGHTNESS"
msgstr ""

#. English: "Added to every colour; 0 leaves it."
msgid "UI_MENU_COLOR_BRIGHTNESS_DESC"
msgstr ""

#. English: "Contrast"
msgid "UI_MENU_COLOR_CONTRAST"
msgstr ""

#. English: "Spreads colours away from mid-grey (above 100 %) or towards it; 100 % leaves them."
msgid "UI_MENU_COLOR_CONTRAST_DESC"
msgstr ""

#. English: "Saturation"
msgid "UI_MENU_COLOR_SATURATION"
msgstr ""

#. English: "Colour strength against grey; 100 % leaves it."
msgid "UI_MENU_COLOR_SATURATION_DESC"
msgstr ""

#. English: "Gamma"
msgid "UI_MENU_COLOR_GAMMA"
msgstr ""

#. English: "Below 1 brightens dark and middle tones, above 1 darkens them; 1 leaves them."
msgid "UI_MENU_COLOR_GAMMA_DESC"
msgstr ""

#. English: "HDR"
msgid "UI_MENU_HDR_GROUP"
msgstr ""

#. English: "HDR output"
msgid "UI_MENU_HDR"
msgstr ""

#. English: "Bright highlights on an HDR display. Needs HDR turned on in Windows (\"Use HDR\") or in a Wayland compositor with colour management; without it the picture stays SDR. Applies after a restart. The colour profile above is for SDR and is not used in HDR."
msgid "UI_MENU_HDR_DESC"
msgstr ""

#. English: "Peak brightness"
msgid "UI_MENU_HDR_PEAK"
msgstr ""

#. English: "Your display's peak in nits; the brightest highlights stop there."
msgid "UI_MENU_HDR_PEAK_DESC"
msgstr ""

#. English: "Game brightness"
msgid "UI_MENU_HDR_GAME"
msgstr ""

#. English: "Nits of the picture's white (paper white). 203 is the HDR reference; raise it in a bright room."
msgid "UI_MENU_HDR_GAME_DESC"
msgstr ""

#. English: "HUD and menu brightness"
msgid "UI_MENU_HDR_UI"
msgstr ""

#. English: "Nits of the HUD's and this menu's white."
msgid "UI_MENU_HDR_UI_DESC"
msgstr ""

#. English: "Highlight hue correction"
msgid "UI_MENU_HDR_HUE"
msgstr ""

#. English: "Bright colours such as fire and sparks turn towards white as in the game's own SDR picture, matching the light they cast; 0 keeps them fully saturated."
msgid "UI_MENU_HDR_HUE_DESC"
msgstr ""

#. English: "Shadow resolution"
msgid "UI_MENU_SHADOW_SCALE"
msgstr ""

#. English: "Draws the sun's shadow map this many times larger on each side than the game's 2048x2048: sharper shadow edges and leaf shadows, for more video memory (about 85 to 130 MiB at 2x, 340 to 520 MiB at 4x). Takes effect at the next start."
msgid "UI_MENU_SHADOW_SCALE_DESC"
msgstr ""

#. English: "Ambient occlusion"
msgid "UI_MENU_AO"
msgstr ""

#. English: "Darkens creases, corners and the ground under characters and objects, where little of the surrounding light reaches. High + bounce light also adds the light the surfaces on screen send back to each other: a lit wall or floor brightens and tints what faces it, even from far away. Computed on the screen after the world is lit; the game has none of its own. Each level costs more GPU time than the one before; High + bounce light is demanding, so on a weak graphics card prefer High. Takes effect at once."
msgid "UI_MENU_AO_DESC"
msgstr ""

#. English: "Off"
msgid "UI_MENU_AO_OFF"
msgstr ""

#. English: "Low"
msgid "UI_MENU_AO_LOW"
msgstr ""

#. English: "High"
msgid "UI_MENU_AO_HIGH"
msgstr ""

#. English: "High + bounce light (demanding)"
msgid "UI_MENU_AO_GI"
msgstr ""

#. English: "Upscaler"
msgid "UI_MENU_UPSCALING"
msgstr ""

#. English: "A temporal upscaler in place of the game's anti-aliasing: smoother edges and less shimmer, and with a mode below Native more frames per second. NVIDIA DLSS needs an NVIDIA RTX GPU and nvngx_dlss.dll next to astralchain.exe, Intel XeSS a recent GPU and libxess.dll next to astralchain.exe; AMD FSR 3 runs on any GPU, AMD FSR 4 on a Radeon RX 6000 or newer. Automatic takes DLSS where it can run and FSR 3 elsewhere. DLSS, XeSS and FSR 4 chosen here take effect after a restart. The HUD is not touched."
msgid "UI_MENU_UPSCALING_DESC"
msgstr ""

#. English: "A temporal upscaler in place of the game's anti-aliasing: smoother edges and less shimmer, and with a mode below Native more frames per second. AMD FSR 3 runs on any GPU, AMD FSR 4 on a Radeon RX 6000 or newer; Automatic is FSR 3 here (NVIDIA DLSS and Intel XeSS are Windows only). FSR 4 chosen here takes effect after a restart. The HUD is not touched."
msgid "UI_MENU_UPSCALING_DESC_OTHER"
msgstr ""

#. English: "Off"
msgid "UI_MENU_UPSCALING_OFF"
msgstr ""

#. English: "Automatic"
msgid "UI_MENU_UPSCALING_AUTO"
msgstr ""

#. English: "not available here"
msgid "UI_MENU_UPSCALING_UNAVAILABLE"
msgstr ""

#. English: "not available here: %s in use"
msgid "UI_MENU_UPSCALING_INSTEAD"
msgstr ""

#. English: "%s is missing: %s in use"
msgid "UI_MENU_UPSCALING_MISSING"
msgstr ""

#. English: "%s until a restart"
msgid "UI_MENU_UPSCALING_UNTIL"
msgstr ""

#. English: "Upscaler mode"
msgid "UI_MENU_UPSCALING_QUALITY"
msgstr ""

#. English: "The size the 3D scene is drawn at before the upscaler brings it to the game resolution (shown under the value). Native draws it at full size, the sharpest (DLAA under DLSS). Quality, Balanced, Performance and Ultra performance draw it at about 67, 58, 50 and 33 % for more frames per second; Ultra performance is meant for 3840 x 2160. Takes effect after a restart."
msgid "UI_MENU_UPSCALING_QUALITY_DESC"
msgstr ""

#. English: "Native"
msgid "UI_MENU_UPSCALING_NATIVE"
msgstr ""

#. English: "Quality"
msgid "UI_MENU_DLSS_QUALITY"
msgstr ""

#. English: "Balanced"
msgid "UI_MENU_DLSS_BALANCED"
msgstr ""

#. English: "Performance"
msgid "UI_MENU_DLSS_PERFORMANCE"
msgstr ""

#. English: "Ultra performance"
msgid "UI_MENU_UPSCALING_ULTRA"
msgstr ""

#. English: "no upscaler"
msgid "UI_MENU_UPSCALING_MODE_OFF"
msgstr ""

#. English: "Game anti-aliasing"
msgid "UI_MENU_AA"
msgstr ""

#. English: "The game's own anti-aliasing, SMAA, for when no upscaler runs. Off leaves the edges jagged."
msgid "UI_MENU_AA_DESC"
msgstr ""

#. English: "Off"
msgid "UI_MENU_AA_OFF"
msgstr ""

#. English: "the upscaler smooths the edges"
msgid "UI_MENU_AA_BY_UPSCALER"
msgstr ""

#. English: "Automatic"
msgid "UI_MENU_OUTPUT_RES_AUTO"
msgstr ""

#. English: ", %s after restart"
msgid "UI_MENU_OUTPUT_RES_NEXT"
msgstr ""

#. English: "Frame rate"
msgid "UI_MENU_FPS_LIMIT"
msgstr ""

#. English: "60 FPS runs the game's 60 fps patch; 30 FPS switches it off. Read live."
msgid "UI_MENU_FPS_LIMIT_DESC"
msgstr ""

#. English: "30 FPS"
msgid "UI_MENU_FPS_30"
msgstr ""

#. English: "60 FPS"
msgid "UI_MENU_FPS_60"
msgstr ""

#. English: "Game speed follows the clock"
msgid "UI_MENU_REALTIME"
msgstr ""

#. English: "Steps the game by real time, so a slow frame does not slow the game down."
msgid "UI_MENU_REALTIME_DESC"
msgstr ""

#. English: "Cloth on the clock"
msgid "UI_MENU_CLOTH_REALTIME"
msgstr ""

#. English: "Steps cloth and hair by real time as well."
msgid "UI_MENU_CLOTH_REALTIME_DESC"
msgstr ""

#. English: "High frame rate fixes"
msgid "UI_MENU_HIGHFPS_FIX"
msgstr ""

#. English: "Corrects physics that misbehave above 30 frames per second, and objects that stay see-through or invisible above 60."
msgid "UI_MENU_HIGHFPS_FIX_DESC"
msgstr ""

#. English: "Game language"
msgid "UI_MENU_GAME_LANG"
msgstr ""

#. English: "Language of the game's text and voices."
msgid "UI_MENU_GAME_LANG_DESC"
msgstr ""

#. English: "Automatic"
msgid "UI_MENU_GAME_LANG_AUTO"
msgstr ""

#. English: "Console mode"
msgid "UI_MENU_OPERATION_MODE"
msgstr ""

#. English: "Whether the game thinks it runs docked or handheld."
msgid "UI_MENU_OPERATION_MODE_DESC"
msgstr ""

#. English: "Docked"
msgid "UI_MENU_MODE_DOCKED"
msgstr ""

#. English: "Handheld"
msgid "UI_MENU_MODE_HANDHELD"
msgstr ""

#. English: "Keep running out of focus"
msgid "UI_MENU_ASSUME_FOCUS"
msgstr ""

#. English: "On (the default), the game keeps running while you are in another window, and the keyboard stays quiet until the window is in front again. Off, the whole game, sound included, pauses while its window is out of focus, as on the Switch when Home is pressed."
msgid "UI_MENU_ASSUME_FOCUS_DESC"
msgstr ""

#. English: "HUD"
msgid "UI_MENU_HUD"
msgstr ""

#. English: "Off, the game's HUD is not drawn during play; the menus stay. F12 toggles it."
msgid "UI_MENU_HUD_DESC"
msgstr ""

#. English: "Installed mods"
msgid "UI_MENU_MODS_INSTALLED"
msgstr ""

#. English: "No mods yet. Unpack a mod into the mods folder, one folder per mod with its romfs folder inside, and restart the game. TKMM can export its merged mods into a folder there too."
msgid "UI_MENU_MODS_NONE"
msgstr ""

#. English: "Open mods folder"
msgid "UI_MENU_MODS_OPEN"
msgstr ""

#. English: "Shows the folder the game loads mods from. It is created if it is missing."
msgid "UI_MENU_MODS_OPEN_DESC"
msgstr ""

#. English: "Downloadable content"
msgid "UI_MENU_DLC_GROUP"
msgstr ""

#. English: "Load DLC"
msgid "UI_MENU_DLC"
msgstr ""

#. English: "Loads the DLCs of the dlc folder next to astralchain.exe: trainings, texts and tutorial windows written by players as XML. They are built into the game's archives from your own game files at start and kept in your profile. Off: the game runs exactly as it is."
msgid "UI_MENU_DLC_DESC"
msgstr ""

#. English: "Loaded at this start: %s."
msgid "UI_MENU_DLC_LOADED"
msgstr ""

#. English: "No DLC was found in the dlc folder at this start."
msgid "UI_MENU_DLC_NONE"
msgstr ""

#. English: "Open DLC folder"
msgid "UI_MENU_DLC_OPEN"
msgstr ""

#. English: "Shows the folder the game loads DLCs from, one folder per DLC with its dlc.xml. It is created if it is missing."
msgid "UI_MENU_DLC_OPEN_DESC"
msgstr ""

#. English: "Game files it replaces: %u. New files it adds: %u."
msgid "UI_MENU_MODS_ROW_DESC"
msgstr ""

#. English: "%u of its files come from %s, which is higher in the list."
msgid "UI_MENU_MODS_OVERRIDDEN"
msgstr ""

#. English: "The top face button or Ctrl+Up moves it up, the left face button or Ctrl+Down moves it down. When two mods change the same file, the higher one wins. Changes apply after a restart."
msgid "UI_MENU_MODS_MOVE_HINT"
msgstr ""

#. English: "This folder has no romfs, exefs or cheats files."
msgid "UI_MENU_MODS_EMPTY"
msgstr ""

#. English: "This mod brings its own game code (a subsdk plugin or a replaced main). The port cannot load code modules, so the whole mod stays off."
msgid "UI_MENU_MODS_SUBSDK"
msgstr ""

#. English: "This mod patches the game code (exefs). The game builds the patches in when it starts next (a rebuild of a few minutes); until then the whole mod stays off."
msgid "UI_MENU_MODS_EXEFS_LATER"
msgstr ""

#. English: "The folder name contains |, which the mod list uses between names. Rename the folder."
msgid "UI_MENU_MODS_BAD_NAME"
msgstr ""

#. English: "This mod patches the game code (exefs) in a way the port cannot apply, so the whole mod stays off. %s"
msgid "UI_MENU_MODS_EXEFS_UNSUPPORTED"
msgstr ""

#. English: "Its code patches (exefs) are made for another game version."
msgid "UI_MENU_MODS_EXEFS_OTHER"
msgstr ""

#. English: "Code patches in use: %d files."
msgid "UI_MENU_MODS_EXEFS_ON"
msgstr ""

#. English: "Code patches in use: %d files. They replace the port's own patch %s, which stays off while this mod is on."
msgid "UI_MENU_MODS_REPLACES_BUILTIN"
msgstr ""

#. English: "%u of its files are made for another game version and are left out. Look for a version of this mod made for your game version."
msgid "UI_MENU_MODS_OTHER_VERSION"
msgstr ""

#. English: "not used"
msgid "UI_MENU_MODS_UNUSED"
msgstr ""

#. English: "Cheats: %d."
msgid "UI_MENU_MODS_CHEATS"
msgstr ""

#. English: "Cheats for this game version are read at start from cheats\\%s in this mod."
msgid "UI_MENU_MODS_CHEATS_FILE"
msgstr ""

#. English: "Volume"
msgid "UI_MENU_VOLUME"
msgstr ""

#. English: "Master volume of the game."
msgid "UI_MENU_VOLUME_DESC"
msgstr ""

#. English: "Audio output"
msgid "UI_MENU_AUDIO_OUTPUT"
msgstr ""

#. English: "What the game mixes. In 5.1 the centre (the voices) and the surrounds get channels of their own; it needs a 5.1 or 7.1 output. Elsewhere the 5.1 mix is folded down to stereo. Automatic picks 5.1 when the output takes it at start, stereo otherwise."
msgid "UI_MENU_AUDIO_OUTPUT_DESC"
msgstr ""

#. English: "What the game mixes. In 5.1 the centre (the voices) and the surrounds get channels of their own; it needs a 5.1 or 7.1 output, or a headset with spatial sound on: Windows Sonic for Headphones, Dolby Atmos for Headphones or DTS Headphone:X, in the device's properties in the Windows sound settings. Elsewhere the 5.1 mix is folded down to stereo. Automatic picks 5.1 when the output takes it at start, stereo otherwise."
msgid "UI_MENU_AUDIO_OUTPUT_DESC_WIN"
msgstr ""

#. English: "Automatic"
msgid "UI_MENU_AUDIO_AUTO"
msgstr ""

#. English: "Stereo"
msgid "UI_MENU_AUDIO_STEREO"
msgstr ""

#. English: "5.1"
msgid "UI_MENU_AUDIO_51"
msgstr ""

#. English: "%s: Windows spatial sound is on and turns 5.1 into surround on headphones."
msgid "UI_MENU_AUDIO_TAKES_51_SPATIAL"
msgstr ""

#. English: "%s: %d channels, 5.1 goes out as it is."
msgid "UI_MENU_AUDIO_TAKES_51"
msgstr ""

#. English: "%s: %d channels, no 5.1: a 5.1 mix is folded down to stereo."
msgid "UI_MENU_AUDIO_FOLDS_51"
msgstr ""

#. English: "With headphones, turn on Windows Sonic for Headphones (or Dolby Atmos, DTS Headphone:X) in the device's properties."
msgid "UI_MENU_AUDIO_SONIC_HINT"
msgstr ""

#. English: "The game sends %d channels."
msgid "UI_MENU_AUDIO_SENDING"
msgstr ""

#. English: "No audio output found."
msgid "UI_MENU_AUDIO_NO_DEVICE"
msgstr ""

#. English: "Choose 5.1 above and restart the game to set each speaker."
msgid "UI_MENU_AUDIO_MIX_HINT"
msgstr ""

#. English: "Speakers and headphones"
msgid "UI_MENU_AUDIO_GROUP_OUTPUT"
msgstr ""

#. English: "Speaker mix"
msgid "UI_MENU_AUDIO_GROUP_MIX"
msgstr ""

#. English: "Closes the game and starts it again with the new audio output. Progress since your last save is lost."
msgid "UI_MENU_AUDIO_RESTART_DESC"
msgstr ""

#. English: "Test speakers"
msgid "UI_MENU_AUDIO_TEST"
msgstr ""

#. English: "Plays a noise on each speaker in turn, as an A/V receiver does: check that every speaker works and sits where the diagram shows it. The game's sound is muted meanwhile. Press again to stop."
msgid "UI_MENU_AUDIO_TEST_DESC"
msgstr ""

#. English: "Start"
msgid "UI_MENU_AUDIO_TEST_START"
msgstr ""

#. English: "press to stop"
msgid "UI_MENU_AUDIO_TEST_STOP"
msgstr ""

#. English: "Mix"
msgid "UI_MENU_AUDIO_PRESET"
msgstr ""

#. English: "Ready-made mixes. Balanced: the recommended mix. Clear voices: the dialogue in front, softer surrounds. Immersive: stronger surrounds, and the bass to the subwoofer. Moving any speaker below makes it Custom."
msgid "UI_MENU_AUDIO_PRESET_DESC"
msgstr ""

#. English: "Balanced"
msgid "UI_MENU_AUDIO_PRESET_BALANCED"
msgstr ""

#. English: "Clear voices"
msgid "UI_MENU_AUDIO_PRESET_VOICES"
msgstr ""

#. English: "Immersive"
msgid "UI_MENU_AUDIO_PRESET_IMMERSIVE"
msgstr ""

#. English: "Custom"
msgid "UI_MENU_AUDIO_PRESET_CUSTOM"
msgstr ""

#. English: "Front left"
msgid "UI_MENU_AUDIO_FRONT_LEFT"
msgstr ""

#. English: "Front right"
msgid "UI_MENU_AUDIO_FRONT_RIGHT"
msgstr ""

#. English: "Centre (voices)"
msgid "UI_MENU_AUDIO_CENTER"
msgstr ""

#. English: "Surround left"
msgid "UI_MENU_AUDIO_SURROUND_LEFT"
msgstr ""

#. English: "Surround right"
msgid "UI_MENU_AUDIO_SURROUND_RIGHT"
msgstr ""

#. English: "Subwoofer"
msgid "UI_MENU_AUDIO_SUBWOOFER"
msgstr ""

#. English: "Level of this front speaker. The fronts carry mostly the music, which the game mixes in stereo, and the sounds in front of you; lowering them lowers the music most. For the music alone, use the game's own music volume."
