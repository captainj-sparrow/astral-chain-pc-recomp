#version 450
// Ambient occlusion, step 2 of 3 (runtime/vk_ao.c run), at half resolution. Each texel's view-space position comes
// from ao_prep.comp's z and the projection's scales (a perspective projection: clip w is a multiple of view z, and x and
// y depend on their own coordinate and z alone, which vk_ao.c checks); the normal from the nearer of its z neighbours
// on each axis. The horizon is then searched along a few screen directions (slices): in each slice, the highest point
// seen above the surface on either side, within a world-space radius, bounds the visible arc, and the cosine-weighted
// visible part of the hemisphere is integrated in closed form over the arc between the two horizons and the normal
// projected into the slice (horizon-based ambient occlusion, after Jimenez et al. 2016, "Practical Real-Time
// Strategies for Accurate Indirect Occlusion"). Slice angles and step offsets follow a 4x4 pattern that ao_apply.frag
// averages out; with the temporal upscaler on, the pattern also turns from frame to frame and the upscaler's history
// averages that.
// Output: .x visibility (1 open, 0 enclosed), .y the texel's view z (0 sky) for the depth-aware blur and upsampling.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D z_tex;
layout(binding = 1) uniform writeonly image2D ao_out;   // RG16F, or RG32F where RG16F cannot be stored (vk_ao.c)
layout(push_constant) uniform P {
    vec4 ndc_to_view;   // x = z * (ndc.x * a + b), y = z * (ndc.y * c + d)
    vec4 size;          // half width, half height, frame index for the pattern, 0
    vec4 radius;        // world radius, half-resolution pixels per unit at view distance 1, largest radius in pixels,
                        // fade distance
    vec4 steps;         // slices, steps per side, 0, 0
} pc;

const float PI = 3.14159265;

vec3 pos_of(vec2 win, float z) {
    vec2 ndc = vec2(win.x / pc.size.x * 2.0 - 1.0, 1.0 - win.y / pc.size.y * 2.0);
    return z * vec3(ndc.x * pc.ndc_to_view.x + pc.ndc_to_view.y, ndc.y * pc.ndc_to_view.z + pc.ndc_to_view.w, 1.0);
}

float z_at(ivec2 q) { return texelFetch(z_tex, clamp(q, ivec2(0), ivec2(pc.size.xy) - 1), 0).r; }

vec3 pos_at(ivec2 q) { return pos_of(vec2(q) + 0.5, z_at(q)); }

// The nearer of two neighbour differences: across an edge the far side belongs to another surface.
vec3 nearer(vec3 c, vec3 a, vec3 b) {
    vec3 da = c - a, db = b - c;
    return abs(da.z) < abs(db.z) ? da : db;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.size.x) || p.y >= int(pc.size.y)) return;
    float z = z_at(p);
    if (z == 0.0) {   // the sky
        imageStore(ao_out, p, vec4(1.0, 0.0, 0.0, 0.0));
        return;
    }
    vec3 P = pos_of(vec2(p) + 0.5, z);
    float dist = length(P);
    float fade = clamp(2.0 - 2.0 * dist / pc.radius.w, 0.0, 1.0);   // gone at the fade distance, full at half of it
    float r_px = min(pc.radius.x * pc.radius.y / abs(z), pc.radius.z);
    if (fade <= 0.0 || r_px < 1.0) {
        imageStore(ao_out, p, vec4(1.0, z, 0.0, 0.0));
        return;
    }
    // the normal; window y down is view y up, so the y difference is taken top minus bottom
    vec3 dx = nearer(P, pos_at(p - ivec2(1, 0)), pos_at(p + ivec2(1, 0)));
    vec3 dy = nearer(P, pos_at(p + ivec2(0, 1)), pos_at(p - ivec2(0, 1)));
    vec3 V = -P / dist;
    vec3 N = normalize(cross(dx, dy));
    if (dot(N, V) < 0.0) N = -N;

    // 4x4 ordered pattern: slice turn and step offset per texel, moving on with the frame index
    const float bayer[16] = float[](0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5);
    float b = bayer[(p.y & 3) * 4 + (p.x & 3)];
    float f = pc.size.z;
    float turn = fract((b + 0.5) / 16.0 + f * 0.6180339);
    float jit = fract((b + 0.5) / 16.0 * 7.0 + f * 0.7548777);

    int slices = int(pc.steps.x), steps = int(pc.steps.y);
    float R2 = pc.radius.x * pc.radius.x;
    float vis = 0.0;
    for (int s = 0; s < slices; s++) {
        float phi = (float(s) + turn) * PI / float(slices);
        vec2 o = vec2(cos(phi), sin(phi));   // window pixels, y down
        vec3 dirV = vec3(o.x, -o.y, 0.0);
        vec3 ortho = normalize(dirV - dot(dirV, V) * V);
        vec3 axis = cross(dirV, V);
        vec3 pn = N - axis * dot(N, axis) / max(dot(axis, axis), 1e-8);
        float plen = length(pn);
        if (plen < 1e-4) continue;
        float cn = clamp(dot(pn, V) / plen, -1.0, 1.0);
        float n = sign(dot(pn, ortho)) * acos(cn);
        // lowest horizons: the tangent plane on either side
        float lo1 = cos(n + PI * 0.5), lo0 = cos(n - PI * 0.5);
        float c1 = lo1, c0 = lo0;
        for (int i = 0; i < steps; i++) {
            float t = (float(i) + jit) / float(steps);
            vec2 so = o * max(t * t * r_px, 1.0 + float(i));
            for (int side = 0; side < 2; side++) {
                vec2 win = vec2(p) + 0.5 + (side == 0 ? so : -so);
                if (win.x < 0.0 || win.y < 0.0 || win.x >= pc.size.x || win.y >= pc.size.y) continue;
                ivec2 sq = ivec2(win);
                float sz = z_at(sq);
                if (sz == 0.0) continue;   // the sky hides nothing
                vec3 H = pos_of(vec2(sq) + 0.5, sz) - P;
                float h2 = dot(H, H);
                if (h2 < 1e-8) continue;
                float ch = dot(H, V) * inversesqrt(h2);
                float wt = clamp(2.0 - 2.0 * h2 / R2, 0.0, 1.0);   // full within 0.7 R, gone at R
                if (side == 0) c1 = max(c1, mix(lo1, ch, wt));
                else c0 = max(c0, mix(lo0, ch, wt));
            }
        }
        float h1 = n + min(acos(c1) - n, PI * 0.5);
        float h0 = n + max(-acos(c0) - n, -PI * 0.5);
        float sn = sin(n);
        float a = 0.25 * (-cos(2.0 * h1 - n) + cn + 2.0 * h1 * sn) + 0.25 * (-cos(2.0 * h0 - n) + cn + 2.0 * h0 * sn);
        vis += plen * a;   // a slice's share: an open surface sums to 1 over the turns, whatever its slant
    }
    float ao = clamp(vis / float(slices), 0.0, 1.0);
    imageStore(ao_out, p, vec4(mix(1.0, ao, fade), z, 0.0, 0.0));
}
